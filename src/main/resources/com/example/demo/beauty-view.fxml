<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="750.0" prefWidth="1400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.BeautyController">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" styleClass="beauty-topbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="15" left="30" right="30" top="15" />
        </padding>
        <Label styleClass="beauty-brand" text="💄 Beauty Paradise" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="Search products..." styleClass="home-search" prefWidth="300">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </TextField>
        <Button onAction="#onToggleAddProduct" styleClass="admin-add-btn" text="➕ Add Product">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </Button>
        <Button onAction="#onBackToHome" styleClass="beauty-back-btn" text="🏠 Back to Home" />
    </HBox>


    <!-- Content Area -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="70.0" prefHeight="630.0" prefWidth="1000.0" styleClass="beauty-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox spacing="25">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <!-- Title -->
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="beauty-page-title" text="Premium Beauty Products" />
                <Rectangle height="4" styleClass="beauty-title-underline" width="80" />
            </VBox>

            <!-- Filter Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="beauty-filter-bar">
                <padding>
                    <Insets bottom="12" left="15" right="15" top="12" />
                </padding>
                <Label styleClass="beauty-filter-label" text="Shop By Category:" />
                <Button fx:id="btnAll" onAction="#onFilterAll" styleClass="beauty-filter beauty-filter-active" text="All Products" />
                <Button fx:id="btnSkincare" onAction="#onFilterSkincare" styleClass="beauty-filter" text="🧴 Skincare" />
                <Button fx:id="btnMakeup" onAction="#onFilterMakeup" styleClass="beauty-filter" text="💄 Makeup" />
                <Button fx:id="btnHaircare" onAction="#onFilterHaircare" styleClass="beauty-filter" text="💇 Haircare" />
            </HBox>

            <!-- Product List - 12 Beauty Products -->
            <VBox fx:id="productList" spacing="10">

                <!-- Row 1: Skincare Products -->
                <!-- Product 1 - Face Cream -->
                <VBox styleClass="beauty-list-row" userData="Skincare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Vitamin C Face Cream" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳1,125 | was ৳1,500" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 2 - Serum -->
                <VBox styleClass="beauty-list-row" userData="Skincare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Hyaluronic Acid Serum" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳1,400 | was ৳2,000" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 3 - Face Wash -->
                <VBox styleClass="beauty-list-row" userData="Skincare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Gentle Foam Cleanser" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳800" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Row 2: Makeup Products -->
                <!-- Product 4 - Lipstick -->
                <VBox styleClass="beauty-list-row" userData="Makeup" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Matte Lipstick Set" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳850 | was ৳1,000" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 5 - Foundation -->
                <VBox styleClass="beauty-list-row" userData="Makeup" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="HD Foundation" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳2,000" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 6 - Eyeshadow -->
                <VBox styleClass="beauty-list-row" userData="Makeup" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Eyeshadow Palette" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳2,000" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Row 3: Haircare Products -->
                <!-- Product 7 - Shampoo -->
                <VBox styleClass="beauty-list-row" userData="Haircare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Keratin Repair Shampoo" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳900" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 8 - Conditioner -->
                <VBox styleClass="beauty-list-row" userData="Haircare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Deep Conditioner" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳1,000" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 9 - Hair Oil -->
                <VBox styleClass="beauty-list-row" userData="Haircare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Argan Hair Oil" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳1,200" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Row 4: Mixed Premium Products -->
                <!-- Product 10 - Sunscreen -->
                <VBox styleClass="beauty-list-row" userData="Skincare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="SPF 50+ Sunscreen" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳910 | was ৳1,300" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 11 - Mascara -->
                <VBox styleClass="beauty-list-row" userData="Makeup" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Volumizing Mascara" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳800" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

                <!-- Product 12 - Gents Face Wash -->
                <VBox styleClass="beauty-list-row" userData="Skincare" alignment="CENTER_LEFT" spacing="6">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                    <Label styleClass="product-name" text="Gents Face Wash" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                    <Label styleClass="product-id-label" text="ID: Loading..." />
                    <Label styleClass="product-price-discount" text="Price: ৳1,500" wrapText="true" maxWidth="Infinity" alignment="CENTER_LEFT" />
                    <Label styleClass="stock-label" text="Stock: 25" maxWidth="Infinity" alignment="CENTER_LEFT" />
                </VBox>

            </VBox>

            <!-- Status -->
            <Label fx:id="statusLabel" styleClass="beauty-status" text="✨ 12 Premium Beauty Products - 5 with Amazing Discounts!" />

        </VBox>
    </ScrollPane>

    <!-- Background Overlay (dims the page when panel is open) - MUST be after ScrollPane to appear on top -->
    <StackPane fx:id="overlayPane" managed="false" visible="false" styleClass="overlay-bg" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    </StackPane>

    <!-- Add Product Panel (Hidden by default) - MUST be after Overlay to appear on top of everything -->
    <VBox fx:id="addProductPanel" alignment="CENTER" managed="false" prefHeight="520" prefWidth="500" spacing="0" styleClass="add-product-panel" visible="false" AnchorPane.leftAnchor="250.0" AnchorPane.topAnchor="90.0">

        <!-- Panel Header (Fixed) -->
        <HBox alignment="CENTER" styleClass="add-product-header">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label styleClass="add-product-title" text="➕ Add New Beauty Product" />
        </HBox>

        <!-- Scrollable Content -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="add-product-scroll" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets bottom="20" left="30" right="30" top="15" />
                </padding>

                <!-- Image Preview -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane prefHeight="140" prefWidth="180" styleClass="image-preview-box">
                        <ImageView fx:id="previewImageView" fitHeight="130" fitWidth="170" preserveRatio="true" />
                        <Label fx:id="noImageLabel" text="📷 No Image Selected" styleClass="no-image-label" />
                    </StackPane>
                    <Button onAction="#onChooseImage" styleClass="choose-image-btn" text="📁 Choose Image" />
                </VBox>

                <!-- Product Name -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Name:" />
                    <TextField fx:id="productNameField" prefHeight="40" prefWidth="420" promptText="Enter product name..." styleClass="form-textfield" />
                </VBox>

                <!-- Product Price -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Price (৳):" />
                    <TextField fx:id="productPriceField" prefHeight="40" prefWidth="420" promptText="Enter price (e.g., 1500)" styleClass="form-textfield" />
                </VBox>

                <!-- Stock Quantity -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Stock Quantity:" />
                    <TextField fx:id="stockQuantityField" prefHeight="40" prefWidth="420" promptText="Enter stock quantity (e.g., 50)" styleClass="form-textfield" />
                </VBox>

                <!-- Product Category -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Category:" />
                    <ComboBox fx:id="categoryComboBox" prefHeight="40" prefWidth="420" promptText="Select Category" styleClass="form-combobox" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="20">
                    <padding>
                        <Insets top="15" />
                    </padding>
                    <Button onAction="#onCancelAddProduct" styleClass="cancel-btn" text="❌ Cancel" />
                    <Button onAction="#onSubmitProduct" styleClass="submit-btn" text="✓ Add Product" />
                </HBox>

                <!-- Status Message -->
                <Label fx:id="addProductStatus" styleClass="add-product-status" text="" />
            </VBox>
        </ScrollPane>
    </VBox>

</AnchorPane>
