<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" styleClass="cart-page-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.CartController">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="64.0" prefWidth="1000.0" styleClass="home-topbar">
        <padding>
            <Insets bottom="12" left="20" right="20" top="12" />
        </padding>
        <Label styleClass="home-brand" text="HATBAZARx" />
        <Region HBox.hgrow="ALWAYS" />
        <Label styleClass="cart-page-title" text="🛒 Shopping Cart" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onBackToHome" styleClass="home-logout" text="← Back" />
    </HBox>

    <!-- Main Content Area -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="64.0" prefHeight="636.0" prefWidth="1000.0" styleClass="cart-scroll-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="64.0">
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="20" />
            </padding>

            <!-- Status Label -->
            <Label fx:id="statusLabel" styleClass="cart-status-label" text="Your Shopping Cart" />

            <!-- Bill/Receipt Paper -->
            <VBox alignment="CENTER" maxWidth="450.0" minWidth="400.0" spacing="0" styleClass="bill-paper">
                <padding>
                    <Insets bottom="25" left="30" right="30" top="25" />
                </padding>

                <!-- Store Header -->
                <Label styleClass="bill-store-name" text="🛒 HATBAZARx" />
                <Label styleClass="bill-divider" text="════════════════════════════════════" />
                <Label styleClass="bill-receipt-title" text="SHOPPING RECEIPT" />
                <Label fx:id="billDateLabel" styleClass="bill-date" text="Date: 20 Feb 2026, 10:30 AM" />
                <Label styleClass="bill-divider" text="════════════════════════════════════" />

                <!-- Bill Items Header -->
                <HBox alignment="CENTER_LEFT" styleClass="bill-header-row">
                    <padding>
                        <Insets bottom="5" top="8" />
                    </padding>
                    <Label minWidth="180.0" styleClass="bill-header-label" text="Item" HBox.hgrow="ALWAYS" />
                    <Label alignment="CENTER" minWidth="40.0" styleClass="bill-header-label-small" text="Qty" />
                    <Label alignment="CENTER_RIGHT" minWidth="80.0" styleClass="bill-header-label-right" text="Price" />
                    <Label alignment="CENTER" minWidth="40.0" styleClass="bill-header-label-small" text="" />
                </HBox>
                <Label styleClass="bill-dotted-line" text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - -" />

                <!-- Bill Items Container (grows with items) -->
                <VBox fx:id="billItemsContainer" spacing="2" styleClass="bill-items-section">
                    <padding>
                        <Insets bottom="5" top="5" />
                    </padding>
                </VBox>

                <Label styleClass="bill-dotted-line" text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - -" />

                <!-- Subtotal Row -->
                <HBox alignment="CENTER_LEFT" styleClass="bill-subtotal-row">
                    <padding>
                        <Insets bottom="5" top="8" />
                    </padding>
                    <Label styleClass="bill-label" text="Subtotal" HBox.hgrow="ALWAYS" />
                    <Label fx:id="subtotalLabel" styleClass="bill-value" text="৳ 0.00" />
                </HBox>

                <!-- Items Count -->
                <HBox alignment="CENTER_LEFT" styleClass="bill-info-row">
                    <padding>
                        <Insets bottom="3" top="3" />
                    </padding>
                    <Label styleClass="bill-label" text="Total Items" HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalItemsLabel" styleClass="bill-value-small" text="0" />
                </HBox>

                <!-- Quantity Count -->
                <HBox alignment="CENTER_LEFT" styleClass="bill-info-row">
                    <padding>
                        <Insets bottom="3" top="3" />
                    </padding>
                    <Label styleClass="bill-label" text="Total Quantity" HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalQuantityLabel" styleClass="bill-value-small" text="0" />
                </HBox>

                <Label styleClass="bill-divider" text="════════════════════════════════════" />

                <!-- Grand Total -->
                <HBox alignment="CENTER_LEFT" styleClass="bill-total-row">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>
                    <Label styleClass="bill-grand-total-label" text="💰 GRAND TOTAL" HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalPriceLabel" styleClass="bill-grand-total-value" text="৳ 0.00 BDT" />
                </HBox>

                <Label styleClass="bill-divider" text="════════════════════════════════════" />

                <!-- Thank You Message -->
                <Label styleClass="bill-thank-you" text="Thank you for shopping with us!" />
                <Label styleClass="bill-contact" text="📞 Support: 01XXXXXXXXX" />

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15" styleClass="bill-buttons">
                    <padding>
                        <Insets top="15" />
                    </padding>
                    <Button onAction="#onClearCart" styleClass="bill-clear-btn" text="🗑️ Clear Cart" />
                    <Button onAction="#onCheckout" styleClass="bill-checkout-btn" text="✓ Checkout" />
                </HBox>
            </VBox>

            <!-- Continue Shopping -->
            <HBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets top="10" />
                </padding>
                <Button onAction="#onContinueShopping" styleClass="cart-continue-btn" text="🛍️ Continue Shopping" />
            </HBox>
        </VBox>
    </ScrollPane>

</AnchorPane>

