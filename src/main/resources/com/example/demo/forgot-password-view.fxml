<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0" prefWidth="1400.0"
           stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.ForgotPasswordController">

    <children>
        <AnchorPane prefHeight="750.0" prefWidth="1250.0">
            <children>
                <!-- Left Decorative Panel -->
                <AnchorPane prefHeight="750.0" prefWidth="625.0" styleClass="left-panel">
                    <children>
                        <Circle fill="#ffffff22" layoutX="120.0" layoutY="160.0" radius="130.0" styleClass="circle-decoration" />
                        <Circle fill="#ffffff11" layoutX="460.0" layoutY="560.0" radius="160.0" styleClass="circle-decoration" />

                        <Label layoutX="80.0" layoutY="250.0" styleClass="welcome-text" text="Recover" textAlignment="LEFT">
                            <font><Font name="System Bold" size="38.0" /></font>
                        </Label>
                        <Label layoutX="80.0" layoutY="310.0" styleClass="welcome-text-large" text="Password" textAlignment="LEFT">
                            <font><Font name="System Bold" size="56.0" /></font>
                        </Label>
                        <Label layoutX="80.0" layoutY="400.0" prefWidth="420.0" styleClass="welcome-subtitle" wrapText="true"
                               text="Enter your recovery info and set a new password." />
                    </children>
                </AnchorPane>

                <!-- Right Recovery Panel -->
                <AnchorPane layoutX="625.0" layoutY="0.0" prefHeight="750.0" prefWidth="625.0" styleClass="right-panel">
                    <children>
                        <VBox alignment="CENTER" layoutX="100.0" layoutY="80.0" prefWidth="425.0" spacing="20.0">
                            <children>
                                <Label prefHeight="45.0" prefWidth="425.0" styleClass="login-title" text="Forgot Password" textAlignment="CENTER">
                                    <font><Font name="System Bold" size="36.0" /></font>
                                </Label>
                                <Label prefHeight="20.0" prefWidth="425.0" styleClass="subtitle"
                                       text="Verify recovery data" textAlignment="CENTER" />

                                <VBox spacing="5.0">
                                    <Label styleClass="field-label" text="Username" />
                                    <TextField fx:id="usernameField" prefHeight="50.0" prefWidth="425.0"
                                               promptText="Your Username" styleClass="modern-field" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label styleClass="field-label" text="Recovery Data" />
                                    <TextField fx:id="personalDataField" prefHeight="50.0" prefWidth="425.0"
                                               promptText="Secret word used during sign up" styleClass="modern-field" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label styleClass="field-label" text="New Password" />
                                    <PasswordField fx:id="newPasswordField" prefHeight="50.0" prefWidth="425.0"
                                                   promptText="Enter new password" styleClass="modern-field" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label styleClass="field-label" text="Confirm New Password" />
                                    <PasswordField fx:id="confirmPasswordField" prefHeight="50.0" prefWidth="425.0"
                                                   promptText="Re-type new password" styleClass="modern-field" />
                                </VBox>

                                <Button prefHeight="55.0" prefWidth="425.0" styleClass="login-button"
                                        text="RESET PASSWORD" onAction="#onResetPassword" wrapText="true" />

                                <HBox spacing="5" alignment="CENTER" prefWidth="425.0">
                                    <Button text="Back to Login" onAction="#onBackToLogin" styleClass="link-button" wrapText="true" />
                                </HBox>

                                <Label fx:id="statusLabel" prefWidth="425.0" wrapText="true" style="-fx-text-fill: #ff4444; -fx-font-weight: bold; -fx-font-size: 14px;" />
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </children>
        </AnchorPane>
    </children>
</StackPane>
