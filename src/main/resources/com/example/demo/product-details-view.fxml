<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="750.0" prefWidth="1400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ProductDetailsController">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" styleClass="product-details-topbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="15" left="30" right="30" top="15" />
        </padding>
        <Button onAction="#onBackToElectronics" styleClass="product-details-back-btn" text="← Back to Electronics" />
        <Region HBox.hgrow="ALWAYS" />
        <Label styleClass="product-details-brand" text="📱 Product Details" />
    </HBox>

    <!-- Content Area -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="70.0" prefHeight="630.0" prefWidth="1000.0" styleClass="product-details-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox spacing="30">
            <padding>
                <Insets bottom="40" left="40" right="40" top="30" />
            </padding>

            <!-- Main Product Section -->
            <HBox spacing="40" styleClass="product-details-main">

                <!-- Left Side - Product Image -->
                <VBox alignment="TOP_CENTER" prefWidth="450" spacing="20" styleClass="product-image-section">
                    <ImageView fx:id="productImage" fitHeight="400" fitWidth="400" preserveRatio="true" styleClass="product-detail-image">
                        <Image url="@../../../images/iphone17.png" />
                    </ImageView>

                    <!-- Discount Badge if applicable -->
                    <Label fx:id="discountBadge" managed="false" styleClass="detail-discount-badge" text="🔥 25% OFF - Limited Time!" visible="false" />
                </VBox>

                <!-- Right Side - Product Details -->
                <VBox prefWidth="480" spacing="20" styleClass="product-info-section">

                    <!-- Product Name & Category -->
                    <VBox spacing="8">
                        <Label fx:id="productCategory" styleClass="product-detail-category" text="Mobile Phone" />
                        <Label fx:id="productName" styleClass="product-detail-name" text="iPhone 17 Pro Max" wrapText="true" />
                    </VBox>

                    <!-- Price Section -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label fx:id="productPrice" styleClass="product-detail-price" text="BDT 1,39,000" />
                        <Label fx:id="originalPrice" managed="false" styleClass="product-detail-original-price" text="BDT 1,85,000" visible="false" />
                    </HBox>

                    <Line endX="450" startX="0" styleClass="detail-separator" />

                    <!-- Technical Specifications - Dynamic VBox -->
                    <VBox fx:id="specsContainer" spacing="15" styleClass="specs-section">
                        <Label styleClass="specs-title" text="📋 Technical Specifications" />
                        <!-- Specifications will be added dynamically based on product type -->
                    </VBox>

                    <Line endX="450" startX="0" styleClass="detail-separator" />

                    <!-- Color Selection -->
                    <VBox spacing="12" styleClass="color-selection-section">
                        <Label styleClass="selection-title" text="🎨 Choose Color:" />
                        <ComboBox fx:id="colorComboBox" prefWidth="300" promptText="Select Color" styleClass="color-combo" />
                    </VBox>

                    <!-- Quantity Selection -->
                    <VBox spacing="12" styleClass="quantity-selection-section">
                        <Label styleClass="selection-title" text="🔢 Quantity:" />
                        <Spinner fx:id="quantitySpinner" editable="true" prefWidth="120" styleClass="quantity-spinner" />
                    </VBox>

                    <Line endX="450" startX="0" styleClass="detail-separator" />

                    <!-- Action Buttons -->
                    <VBox spacing="15">
                        <Button fx:id="addToCartBtn" onAction="#onAddToCart" prefHeight="50" prefWidth="480" styleClass="detail-add-cart-btn" text="🛒 Add to Cart" style="-fx-font-size:12; -fx-letter-spacing:0.5;"/>
                        <Button onAction="#onBuyNow" prefHeight="45" prefWidth="480" styleClass="detail-buy-now-btn" text="⚡ Buy Now" style="-fx-font-size:12; -fx-letter-spacing:0.5;"/>
                    </VBox>

                    <!-- Status Message -->
                    <Label fx:id="statusLabel" managed="false" styleClass="detail-status-message" text="" visible="false" wrapText="true" />

                </VBox>
            </HBox>

            <!-- Product Description -->
            <VBox spacing="15" styleClass="product-description-section">
                <Label styleClass="description-title" text="📖 Product Description" />
                <Label fx:id="productDescription" styleClass="description-text" text="Experience the future with iPhone 17 Pro Max. Featuring cutting-edge technology, stunning design, and powerful performance. Perfect for professionals and tech enthusiasts who demand the best." wrapText="true" />
            </VBox>

            <!-- Features Section -->
            <VBox spacing="15" styleClass="features-section">
                <Label styleClass="features-title" text="⭐ Key Features" />
                <VBox spacing="10">
                    <HBox spacing="10">
                        <Label styleClass="feature-bullet" text="✓" />
                        <Label styleClass="feature-text" text="Advanced A17 Bionic chip for lightning-fast performance" wrapText="true" />
                    </HBox>
                    <HBox spacing="10">
                        <Label styleClass="feature-bullet" text="✓" />
                        <Label styleClass="feature-text" text="Professional-grade camera system with AI enhancement" wrapText="true" />
                    </HBox>
                    <HBox spacing="10">
                        <Label styleClass="feature-bullet" text="✓" />
                        <Label styleClass="feature-text" text="All-day battery life with fast charging support" wrapText="true" />
                    </HBox>
                    <HBox spacing="10">
                        <Label styleClass="feature-bullet" text="✓" />
                        <Label styleClass="feature-text" text="Premium titanium design with ceramic shield protection" wrapText="true" />
                    </HBox>
                    <HBox spacing="10">
                        <Label styleClass="feature-bullet" text="✓" />
                        <Label styleClass="feature-text" text="5G connectivity for blazing-fast internet speeds" wrapText="true" />
                    </HBox>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

</AnchorPane>

