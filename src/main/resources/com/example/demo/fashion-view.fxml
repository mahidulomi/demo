<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ComboBox?>

<AnchorPane prefHeight="750.0" prefWidth="1400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.FashionController">

    <!-- Top Bar -->
    <HBox layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" styleClass="fashion-topbar" alignment="CENTER_LEFT" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30" right="30" top="15" bottom="15" />
        </padding>
        <Label text="👗 Fashion Boutique" styleClass="fashion-brand" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="Search products..." styleClass="home-search" prefWidth="300">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </TextField>
        <Button text="➕ Add Product" onAction="#onToggleAddProduct" styleClass="admin-add-btn">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </Button>
        <Button text="🏠 Back to Home" onAction="#onBackToHome" styleClass="fashion-back-btn" />
    </HBox>

    <!-- Content Area -->
    <ScrollPane layoutY="70.0" prefWidth="1000.0" prefHeight="630.0" fitToWidth="true" styleClass="fashion-scroll" hbarPolicy="NEVER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0" AnchorPane.bottomAnchor="0.0">
        <VBox spacing="25">
            <padding>
                <Insets left="30" right="30" top="25" bottom="25" />
            </padding>

            <!-- Title -->
            <VBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Discover Our Collection" styleClass="fashion-page-title" />
                <Rectangle width="80" height="4" styleClass="fashion-title-underline" />
            </VBox>

            <!-- Filter Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="fashion-filter-bar">
                <padding>
                    <Insets top="12" bottom="12" left="15" right="15" />
                </padding>
                <Label text="Shop By Category:" styleClass="fashion-filter-label" />
                <Button fx:id="btnAll" text="All Products" onAction="#onFilterAll" styleClass="fashion-filter fashion-filter-active" />
                <Button fx:id="btnBaby" text="👶 Baby" onAction="#onFilterBaby" styleClass="fashion-filter" />
                <Button fx:id="btnMale" text="👔 Male" onAction="#onFilterMale" styleClass="fashion-filter" />
                <Button fx:id="btnFemale" text="👗 Female" onAction="#onFilterFemale" styleClass="fashion-filter" />
            </HBox>

            <!-- Product List - 12 Fashion Products -->
            <GridPane fx:id="productGrid" hgap="0" vgap="10" alignment="TOP_LEFT">

                <VBox userData="Baby" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Baby Romper Set" styleClass="product-name" />
                    <Label text="ID: F_BabyRomper" styleClass="product-id-label" />
                    <Label text="Price: ৳360 (was ৳450)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Baby" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Baby Cotton Dress" styleClass="product-name" />
                    <Label text="ID: F_BabyDress" styleClass="product-id-label" />
                    <Label text="Price: ৳468 (was ৳550)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Baby" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Baby Summer Shorts" styleClass="product-name" />
                    <Label text="ID: F_BabyShorts" styleClass="product-id-label" />
                    <Label text="Price: ৳263 (was ৳350)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Male" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Men's Casual Shirt" styleClass="product-name" />
                    <Label text="ID: F_MenShirt" styleClass="product-id-label" />
                    <Label text="Price: ৳900 (was ৳1,200)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Male" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Men's Denim Jeans" styleClass="product-name" />
                    <Label text="ID: F_MenJeans" styleClass="product-id-label" />
                    <Label text="Price: ৳1260 (was ৳1,800)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Male" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Men's Premium Kurta" styleClass="product-name" />
                    <Label text="ID: F_MenKurta" styleClass="product-id-label" />
                    <Label text="Price: ৳850 (was ৳1,000)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Female" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="6">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Women's Designer Kurti" styleClass="product-name" />
                    <Label text="ID: F_WomenKurti" styleClass="product-id-label" />
                    <Label text="Price: ৳760 (was ৳950)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Female" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="7">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Women's Silk Saree" styleClass="product-name" />
                    <Label text="ID: F_WomenSaree" styleClass="product-id-label" />
                    <Label text="Price: ৳2,125 (was ৳2,500)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Female" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="8">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Women's Salwar Kameez" styleClass="product-name" />
                    <Label text="ID: F_WomenSalwar" styleClass="product-id-label" />
                    <Label text="Price: ৳1,200 (was ৳1,600)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Baby" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="9">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Baby Winter Jacket" styleClass="product-name" />
                    <Label text="ID: F_BabyJacket" styleClass="product-id-label" />
                    <Label text="Price: ৳840 (was ৳1,200)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Male" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="10">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Men's Premium Hoodie" styleClass="product-name" />
                    <Label text="ID: F_MenHoodie" styleClass="product-id-label" />
                    <Label text="Price: ৳1,312 (was ৳1,600)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

                <VBox userData="Female" styleClass="product-card" prefWidth="920" prefHeight="120" alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="11">
                    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                    <Label text="Women's Lehenga Choli" styleClass="product-name" />
                    <Label text="ID: F_WomenLehenga" styleClass="product-id-label" />
                    <Label text="Price: ৳2,450 (was ৳3,500)" styleClass="product-price-discount" />
                    <Label text="Stock: 25" styleClass="stock-label" />
                </VBox>

            </GridPane>

            <!-- Status -->
            <Label fx:id="statusLabel" text="👗 12 Fashion Items - All with Amazing Discounts!" styleClass="fashion-status" />
        </VBox>
    </ScrollPane>

    <!-- Background Overlay (dims the page when panel is open) - MUST be after ScrollPane to appear on top -->
    <StackPane fx:id="overlayPane" managed="false" visible="false" styleClass="overlay-bg" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    </StackPane>

    <!-- Add Product Panel (Hidden by default) - MUST be after Overlay to appear on top of everything -->
    <VBox fx:id="addProductPanel" alignment="CENTER" managed="false" prefHeight="520" prefWidth="500" spacing="0" styleClass="add-product-panel" visible="false" AnchorPane.leftAnchor="250.0" AnchorPane.topAnchor="90.0">

        <!-- Panel Header (Fixed) -->
        <HBox alignment="CENTER" styleClass="add-product-header">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label styleClass="add-product-title" text="➕ Add New Fashion Item" />
        </HBox>

        <!-- Scrollable Content -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="add-product-scroll" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets bottom="20" left="30" right="30" top="15" />
                </padding>

                <!-- Image Preview -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane prefHeight="140" prefWidth="180" styleClass="image-preview-box">
                        <ImageView fx:id="previewImageView" fitHeight="130" fitWidth="170" preserveRatio="true" />
                        <Label fx:id="noImageLabel" text="📷 No Image Selected" styleClass="no-image-label" />
                    </StackPane>
                    <Button onAction="#onChooseImage" styleClass="choose-image-btn" text="📁 Choose Image" />
                </VBox>

                <!-- Product Name -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Name:" />
                    <TextField fx:id="productNameField" prefHeight="40" prefWidth="420" promptText="Enter product name..." styleClass="form-textfield" />
                </VBox>

                <!-- Product Price -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Price (৳):" />
                    <TextField fx:id="productPriceField" prefHeight="40" prefWidth="420" promptText="Enter price (e.g., 500)" styleClass="form-textfield" />
                </VBox>

                <!-- Stock Quantity -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Stock Quantity:" />
                    <TextField fx:id="stockQuantityField" prefHeight="40" prefWidth="420" promptText="Enter stock quantity (e.g., 20)" styleClass="form-textfield" />
                </VBox>

                <!-- Product Category -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Category:" />
                    <ComboBox fx:id="categoryComboBox" prefHeight="40" prefWidth="420" promptText="Select Category" styleClass="form-combobox" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="20">
                    <padding>
                        <Insets top="15" />
                    </padding>
                    <Button onAction="#onCancelAddProduct" styleClass="cancel-btn" text="❌ Cancel" />
                    <Button onAction="#onSubmitProduct" styleClass="submit-btn" text="✓ Add Product" />
                </HBox>

                <!-- Status Message -->
                <Label fx:id="addProductStatus" styleClass="add-product-status" text="" />
            </VBox>
        </ScrollPane>
    </VBox>

</AnchorPane>
