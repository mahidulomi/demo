<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.TilePane?>

<AnchorPane prefHeight="750.0" prefWidth="1250.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.CustomerHomeController">
    <children>
        <!-- Header - Green Background -->
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1250.0" style="-fx-background-color: #27ae60;" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <Label fx:id="greetingLabel" text="Hello, Customer!" textFill="WHITE" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="cartButton" mnemonicParsing="false" onAction="#onViewCart" text="Cart (0)" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                <Button mnemonicParsing="false" onAction="#onLogout" text="Logout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;">
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

        <!-- Main Content Area - Black/Dark Theme -->
        <VBox layoutY="70.0" prefHeight="680.0" prefWidth="1250.0" spacing="10" style="-fx-background-color: #1a1a1a;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>

            <!-- Search and Categories -->
            <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="50.0">
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="350.0" promptText="Search products..." style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-border-color: #444; -fx-padding: 10;" />
                <Region HBox.hgrow="ALWAYS" />

                <!-- Category Buttons -->
                <Button minHeight="40.0" minWidth="70.0" mnemonicParsing="false" onAction="#onCategoryAll" text="All" style="-fx-background-color: #333333; -fx-text-fill: white;" />
                <Button minHeight="40.0" minWidth="100.0" mnemonicParsing="false" onAction="#onCategoryBeauty" text="Beauty" style="-fx-background-color: #333333; -fx-text-fill: white;" />
                <Button minHeight="40.0" minWidth="120.0" mnemonicParsing="false" onAction="#onCategoryElectronics" text="Electronics" style="-fx-background-color: #333333; -fx-text-fill: white;" />
                <Button minHeight="40.0" minWidth="100.0" mnemonicParsing="false" onAction="#onCategoryHomeAndLiving" text="Home" style="-fx-background-color: #333333; -fx-text-fill: white;" />
                <Button minHeight="40.0" minWidth="100.0" mnemonicParsing="false" onAction="#onCategoryFashion" text="Fashion" style="-fx-background-color: #333333; -fx-text-fill: white;" />
            </HBox>

            <!-- Products Grid - TilePane for 4 columns -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: #1a1a1a; -fx-padding: 0;" focusTraversable="false" VBox.vgrow="ALWAYS">
                <TilePane fx:id="productsFlowPane" hgap="20" vgap="20" prefColumns="4" tileAlignment="TOP_CENTER" alignment="TOP_CENTER" style="-fx-padding: 15; -fx-background-color: #1a1a1a;">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                </TilePane>
            </ScrollPane>
        </VBox>
    </children>
</AnchorPane>

