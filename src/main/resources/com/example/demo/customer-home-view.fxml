<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1250.0" style="-fx-background-color: #1a1a1a;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.CustomerHomeController">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1250.0" style="-fx-background-color: #11998e;" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <Label fx:id="greetingLabel" text="Hello, Customer!" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="cartButton" mnemonicParsing="false" onAction="#onViewCart" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🛒 Cart (0)" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#onLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Logout">
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

        <!-- Search Bar -->
        <HBox alignment="CENTER" layoutY="70.0" prefHeight="60.0" prefWidth="1250.0" style="-fx-background-color: #262626;">
            <children>
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="600.0" promptText="🔍 Search products..." style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #444; -fx-background-color: #333333; -fx-text-fill: white;" />
                <Button mnemonicParsing="false" onAction="#onSearch" style="-fx-background-color: #11998e; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Search">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

        <!-- Main Content Area -->
        <ScrollPane fitToWidth="true" layoutY="130.0" prefHeight="620.0" prefWidth="1250.0" style="-fx-background-color: #1a1a1a; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="130.0">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: #1a1a1a;">
                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>
                        <!-- Categories -->
                        <HBox alignment="CENTER" spacing="40.0">
                            <children>
                                <Button minHeight="60.0" minWidth="60.0" mnemonicParsing="false" onAction="#onCategoryAll" style="-fx-background-color: #333333; -fx-background-radius: 10; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2); -fx-cursor: hand;" text="All" />
                                <Button minHeight="60.0" minWidth="60.0" mnemonicParsing="false" onAction="#onCategoryElectronics" style="-fx-background-color: #333333; -fx-background-radius: 10; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2); -fx-cursor: hand;" text="Electronics" />
                                <Button minHeight="60.0" minWidth="60.0" mnemonicParsing="false" onAction="#onCategoryBeauty" style="-fx-background-color: #333333; -fx-background-radius: 10; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2); -fx-cursor: hand;" text="Beauty" />
                                <Button minHeight="60.0" minWidth="60.0" mnemonicParsing="false" onAction="#onCategoryFashion" style="-fx-background-color: #333333; -fx-background-radius: 10; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2); -fx-cursor: hand;" text="Fashion" />
                            </children>
                        </HBox>

                        <Label text="Featured Products" style="-fx-text-fill: white;">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>

                        <!-- Products Grid -->
                        <FlowPane fx:id="productsFlowPane" hgap="20.0" vgap="20.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

