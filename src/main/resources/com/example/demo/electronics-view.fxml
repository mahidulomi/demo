<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ElectronicsController">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" styleClass="electronics-topbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="15" left="30" right="30" top="15" />
        </padding>
        <Label styleClass="electronics-brand" text="⚡ Electronics Hub" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onBackToHome" styleClass="electronics-back-btn" text="🏠 Back to Home" />
    </HBox>

    <!-- Content Area -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="70.0" prefHeight="630.0" prefWidth="1000.0" styleClass="electronics-scroll" AnchorPane.bottomAnchor="0.39999999999997726" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox spacing="25">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <!-- Title -->
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="electronics-page-title" text="Latest Electronics" />
                <Rectangle height="4" styleClass="electronics-title-underline" width="80" />
            </VBox>

            <!-- Filter Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="electronics-filter-bar">
                <padding>
                    <Insets bottom="12" left="15" right="15" top="12" />
                </padding>
                <Label styleClass="electronics-filter-label" text="Shop By Category:" />
                <Button fx:id="btnAll" onAction="#onFilterAll" styleClass="electronics-filter electronics-filter-active" text="All Products" />
                <Button fx:id="btnMobile" onAction="#onFilterMobile" styleClass="electronics-filter" text="📱 Mobile" />
                <Button fx:id="btnLaptop" onAction="#onFilterLaptop" styleClass="electronics-filter" text="💻 Laptop" />
                <Button fx:id="btnAccessories" onAction="#onFilterAccessories" styleClass="electronics-filter" text="🎧 Accessories" />
            </HBox>

            <!-- Product Grid - 13 Electronics Products -->
            <GridPane fx:id="productGrid" hgap="20" vgap="20" alignment="CENTER">

                <!-- Row 1: Mobile Products -->
                <!-- Product 1 - iPhone 15 -->
                <VBox userData="Mobile" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/iphone15.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="iPhone 15" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 99,999" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 2 - iPhone 16 -->
                <VBox userData="Mobile" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/iphone16.png" />
                        </ImageView>
                        <Label text="🔥 20% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="iPhone 16" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 96,000  (was BDT 1,20,000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 3 - iPhone 17 -->
                <VBox userData="Mobile" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/iphone17.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="iPhone 17" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 1,39,000" styleClass="product-price-discount" />
                </VBox>

                <!-- Row 2: More Mobile Products -->
                <!-- Product 4 - Samsung Galaxy S25 -->
                <VBox userData="Mobile" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/samsungs25.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="Samsung Galaxy S25" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 1,20,000" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 5 - Vivo X200 Ultra -->
                <VBox userData="Mobile" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/vivox200ultra.png" />
                        </ImageView>
                        <Label text="🔥 18% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Vivo X200 Ultra" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 73,800  (was BDT 90,000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 6 - Lenovo Laptop -->
                <VBox userData="Laptop" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/loglenevo.png" />
