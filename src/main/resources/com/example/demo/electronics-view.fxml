<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ElectronicsController">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1000.0" styleClass="electronics-topbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="15" left="30" right="30" top="15" />
        </padding>
        <Label styleClass="electronics-brand" text="⚡ Electronics Hub" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="Search products..." styleClass="home-search" prefWidth="300">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </TextField>
        <Button onAction="#onToggleAddProduct" styleClass="admin-add-btn" text="➕ Add Product">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </Button>
        <Button onAction="#onBackToHome" styleClass="electronics-back-btn" text="🏠 Back to Home" />
    </HBox>


    <!-- Content Area -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="70.0" prefHeight="630.0" prefWidth="1000.0" styleClass="electronics-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <VBox spacing="25">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <!-- Title -->
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="electronics-page-title" text="Latest Electronics" />
                <Rectangle height="4" styleClass="electronics-title-underline" width="80" />
            </VBox>

            <!-- Filter Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="electronics-filter-bar">
                <padding>
                    <Insets bottom="12" left="15" right="15" top="12" />
                </padding>
                <Label styleClass="electronics-filter-label" text="Shop By Category:" />
<Button fx:id="btnAll" onAction="#onFilterAll" styleClass="electronics-filter electronics-filter-active" text="All Products" />
                <Button fx:id="btnMobile" onAction="#onFilterMobile" styleClass="electronics-filter" text="📱 Mobile" />
                <Button fx:id="btnLaptop" onAction="#onFilterLaptop" styleClass="electronics-filter" text="💻 Laptop" />
                <Button fx:id="btnAccessories" onAction="#onFilterAccessories" styleClass="electronics-filter" text="🎧 Accessories" />
            </HBox>

            <!-- Product List - 13 Electronics Products -->
            <GridPane fx:id="productGrid" alignment="TOP_LEFT" hgap="0" vgap="10">

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Mobile" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="iPhone 15" />
                    <Label styleClass="product-id-label" text="ID: E_iPhone15" />
                    <Label styleClass="product-price-discount" text="Price: ৳99,999" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Mobile" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="iPhone 16" />
                    <Label styleClass="product-id-label" text="ID: E_iPhone16" />
                    <Label styleClass="product-price-discount" text="Price: ৳96,000 (was ৳1,20,000)" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Mobile" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="iPhone 17" />
                    <Label styleClass="product-id-label" text="ID: E_iPhone17" />
                    <Label styleClass="product-price-discount" text="Price: ৳1,39,000" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Mobile" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Samsung Galaxy S25" />
                    <Label styleClass="product-id-label" text="ID: E_SamsungS25" />
                    <Label styleClass="product-price-discount" text="Price: ৳1,20,000" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Mobile" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Vivo X200 Ultra" />
                    <Label styleClass="product-id-label" text="ID: E_VivoX200" />
                    <Label styleClass="product-price-discount" text="Price: ৳73,800 (was ৳90,000)" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Laptop" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Lenovo IdeaPad i5 8GB SSD" />
                    <Label styleClass="product-id-label" text="ID: E_LenovoIdeaPad" />
                    <Label styleClass="product-price-discount" text="Price: ৳1,19,000 (was ৳1,44,000)" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Accessories" GridPane.columnIndex="0" GridPane.rowIndex="6">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Wireless Earbuds Pro" />
                    <Label styleClass="product-id-label" text="ID: E_WirelessEarbuds" />
                    <Label styleClass="product-price-discount" text="Price: ৳5,000" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Accessories" GridPane.columnIndex="0" GridPane.rowIndex="7">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Smart Watch Fitness" />
                    <Label styleClass="product-id-label" text="ID: E_SmartWatch" />
                    <Label styleClass="product-price-discount" text="Price: ৳10,000" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Accessories" GridPane.columnIndex="0" GridPane.rowIndex="8">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Power Bank 20000mAh" />
                    <Label styleClass="product-id-label" text="ID: E_PowerBank" />
                    <Label styleClass="product-price-discount" text="Price: ৳2,500" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Mobile" GridPane.columnIndex="0" GridPane.rowIndex="9">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="iPad" />
                    <Label styleClass="product-id-label" text="ID: E_iPad" />
                    <Label styleClass="product-price-discount" text="Price: ৳23,400 (was ৳30,000)" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Accessories" GridPane.columnIndex="0" GridPane.rowIndex="10">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Mouse" />
                    <Label styleClass="product-id-label" text="ID: E_Mouse" />
                    <Label styleClass="product-price-discount" text="Price: ৳3,600 (was ৳5,000)" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Laptop" GridPane.columnIndex="0" GridPane.rowIndex="11">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Asus VivoBook Ryzen 5 16GB" />
                    <Label styleClass="product-id-label" text="ID: E_AsusVivoBook" />
                    <Label styleClass="product-price-discount" text="Price: ৳1,16,000" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <VBox alignment="CENTER_LEFT" prefHeight="120" prefWidth="920" spacing="6" styleClass="product-card" userData="Accessories" GridPane.columnIndex="0" GridPane.rowIndex="12">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label styleClass="product-name" text="Ajazz K80 Redswitch" />
                    <Label styleClass="product-id-label" text="ID: E_AjazzK80" />
                    <Label styleClass="product-price-discount" text="Price: ৳4,200" />
                    <Label styleClass="stock-label" text="Stock: 25" />
                </VBox>

                <columnConstraints>
                    <ColumnConstraints />
                </columnConstraints>
            </GridPane>

            <!-- Status -->
            <Label fx:id="statusLabel" styleClass="electronics-status" text="⚡ 13 Latest Electronics - 5 with Amazing Discounts!" />

        </VBox>
    </ScrollPane>

    <!-- Background Overlay (dims the page when panel is open) - MUST be after ScrollPane to appear on top -->
    <StackPane fx:id="overlayPane" managed="false" visible="false" styleClass="overlay-bg" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    </StackPane>

    <!-- Add Product Panel (Hidden by default) - MUST be after Overlay to appear on top of everything -->
    <VBox fx:id="addProductPanel" alignment="CENTER" managed="false" prefHeight="520" prefWidth="500" spacing="0" styleClass="add-product-panel" visible="false" AnchorPane.leftAnchor="250.0" AnchorPane.topAnchor="90.0">

        <!-- Panel Header (Fixed) -->
        <HBox alignment="CENTER" styleClass="add-product-header">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label styleClass="add-product-title" text="➕ Add New Electronics Product" />
        </HBox>

        <!-- Scrollable Content -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="add-product-scroll" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets bottom="20" left="30" right="30" top="15" />
                </padding>

                <!-- Image Preview -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane prefHeight="140" prefWidth="180" styleClass="image-preview-box">
                        <ImageView fx:id="previewImageView" fitHeight="130" fitWidth="170" preserveRatio="true" />
                        <Label fx:id="noImageLabel" text="📷 No Image Selected" styleClass="no-image-label" />
                    </StackPane>
                    <Button onAction="#onChooseImage" styleClass="choose-image-btn" text="📁 Choose Image" />
                </VBox>

                <!-- Product Name -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Name:" />
                    <TextField fx:id="productNameField" prefHeight="40" prefWidth="420" promptText="Enter product name..." styleClass="form-textfield" />
                </VBox>

                <!-- Product Price -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Price (৳):" />
                    <TextField fx:id="productPriceField" prefHeight="40" prefWidth="420" promptText="Enter price (e.g., 50000)" styleClass="form-textfield" />
                </VBox>

                <!-- Stock Quantity -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Stock Quantity:" />
                    <TextField fx:id="stockQuantityField" prefHeight="40" prefWidth="420" promptText="Enter stock quantity (e.g., 20)" styleClass="form-textfield" />
                </VBox>

                <!-- Product Category -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Category:" />
                    <ComboBox fx:id="categoryComboBox" prefHeight="40" prefWidth="420" promptText="Select Category" styleClass="form-combobox" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="20">
                    <padding>
                        <Insets top="15" />
                    </padding>
                    <Button onAction="#onCancelAddProduct" styleClass="cancel-btn" text="❌ Cancel" />
                    <Button onAction="#onSubmitProduct" styleClass="submit-btn" text="✓ Add Product" />
                </HBox>

                <!-- Status Message -->
                <Label fx:id="addProductStatus" styleClass="add-product-status" text="" />
            </VBox>
        </ScrollPane>
    </VBox>

</AnchorPane>

