                    </StackPane>
                    <Label text="Wireless Earbuds Pro" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 5,000" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 8 - Smart Watch -->
                <VBox userData="Accessories" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/titan.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="Smart Watch Fitness" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 10,000" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 9 - Power Bank -->
                <VBox userData="Accessories" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/powerbank.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="Power Bank 20000mAh" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 2,500" styleClass="product-price-discount" />
                </VBox>

                <!-- Row 4: Mixed Premium Products -->
                <!-- Product 10 - iPad -->
                <VBox userData="Mobile" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/ipad.png" />
                        </ImageView>
                        <Label text="🔥 22% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="iPad" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 23,400  (was BDT 30,000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 11 - Mouse -->
                <VBox userData="Accessories" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/mouise.png" />
                        </ImageView>
                        <Label text="🔥 28% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Mouse" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 3,600  (was BDT 5,000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 12 - Asus Laptop -->
                <VBox userData="Laptop" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="2" GridPane.rowIndex="3">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/asus.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="Asus VivoBook Ryzen 5 16GB" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 1,16,000" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 13 - Ajazz Keyboard -->
                <VBox userData="Accessories" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/ajaj.png" />
                        </ImageView>
                    </StackPane>
                    <Label text="Ajazz K80 Redswitch" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 4,200" styleClass="product-price-discount" />
                </VBox>

            </GridPane>

            <!-- Status -->
            <Label fx:id="statusLabel" styleClass="electronics-status" text="⚡ 13 Latest Electronics - All with Amazing Discounts!" />

        </VBox>
    </ScrollPane>

</AnchorPane>
