                <Button fx:id="btnMobile" text="📱 Mobile" onAction="#onFilterMobile" styleClass="electronics-filter" />
                <Button fx:id="btnLaptop" text="💻 Laptop" onAction="#onFilterLaptop" styleClass="electronics-filter" />
                <Button fx:id="btnAccessories" text="🎧 Accessories" onAction="#onFilterAccessories" styleClass="electronics-filter" />
