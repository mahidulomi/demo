                        <Label text="🔥 15% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Lenovo IdeaPad i5 8GB SSD" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="BDT 1,19,000  (was BDT 1,44,000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Row 3: Accessories Products -->
                <!-- Product 7 - Wireless Earbuds -->
                <VBox userData="Accessories" styleClass="product-card clickable-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" onMouseClicked="#onProductClick" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <ImageView fitHeight="200" fitWidth="260" preserveRatio="true">
                            <Image url="@../../../images/airpods.png" />
