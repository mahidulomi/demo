                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="📱" style="-fx-font-size: 64px;" />
                        <Label text="🔥 15% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="5G Smartphone 128GB" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳29750  (was ৳35000)" styleClass="product-price-discount" />
                    <Button text="🛒 Add to Cart" styleClass="product-add-btn" prefWidth="240" onAction="#onAddToCart" />
