<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0"
           stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.HelloController">
    <children>
        <AnchorPane prefHeight="700.0" prefWidth="1000.0">
            <children>
                <!-- Left Decorative Panel -->
                <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="700.0" prefWidth="550.0" styleClass="left-panel">
                    <children>
                        <!-- Decorative Circles -->
                        <Circle fill="#ffffff33" layoutX="100.0" layoutY="150.0" radius="120.0" styleClass="circle-decoration" />
                        <Circle fill="#ffffff22" layoutX="450.0" layoutY="550.0" radius="150.0" styleClass="circle-decoration" />
                        <Circle fill="#ffffff11" layoutX="80.0" layoutY="500.0" radius="80.0" styleClass="circle-decoration" />

                        <!-- Welcome Text -->
                        <Label layoutX="80.0" layoutY="250.0" prefHeight="80.0" prefWidth="400.0" styleClass="welcome-text" text="Welcome to" textAlignment="LEFT">
                            <font>
                                <Font name="System Bold" size="38.0" />
                            </font>
                        </Label>
                        <Label layoutX="80.0" layoutY="310.0" prefHeight="80.0" prefWidth="400.0" styleClass="welcome-text-large" text="HATBAZARx" textAlignment="LEFT">
                            <font>
                                <Font name="System Bold" size="56.0" />
                            </font>
                        </Label>
                        <Label layoutX="80.0" layoutY="390.0" prefHeight="72.0" prefWidth="440.0"
                               styleClass="welcome-subtitle" textAlignment="LEFT" wrapText="true"
                               text="Buet er assignment e jemon focus&#10;Product eo temon !!">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Label>
                    </children>
                </AnchorPane>

                <!-- Right Login Panel -->
                <AnchorPane layoutX="604.0" layoutY="-3.0" prefHeight="694.0" prefWidth="382.0" styleClass="right-panel">
                    <children>
                        <!-- Login Form -->
                        <Label layoutX="57.0" layoutY="60.0" prefHeight="45.0" prefWidth="260.0" styleClass="login-title" text="Welcome Back!" textAlignment="CENTER">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Label layoutX="57.0" layoutY="115.0" prefHeight="20.0" prefWidth="260.0" styleClass="subtitle" text="Login to your account" textAlignment="CENTER">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <!-- Decorative Line -->
                        <Rectangle arcHeight="10.0" arcWidth="10.0" height="3.0" layoutX="137.0" layoutY="150.0" styleClass="decorative-line" width="100.0" />

                        <Label layoutX="57.0" layoutY="185.0" styleClass="field-label" text="Username">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" layoutX="57.0" layoutY="212.0" maxWidth="260.0" prefHeight="45.0" prefWidth="260.0" promptText="Enter your username" styleClass="modern-field" />

                        <Label layoutX="57.0" layoutY="277.0" styleClass="field-label" text="Password">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" layoutX="57.0" layoutY="304.0" prefHeight="45.0" prefWidth="260.0" promptText="Enter your password" styleClass="modern-field" />

                        <Hyperlink layoutX="192.0" layoutY="359.0" styleClass="forgot-link" text="Forgot Password?" />

                        <Button layoutX="105.0" layoutY="400.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="164.0" styleClass="login-button" text="LOGIN" onAction="#onLogin">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>

                        <Label layoutX="85.0" layoutY="475.0" styleClass="signup-text" text="Don't have an account?">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <Hyperlink layoutX="223.0" layoutY="473.0" styleClass="signup-link" text="Sign Up" onAction="#onSignUp" />

                        <!-- Status label to show errors/success -->
                        <Label fx:id="welcomeText" layoutX="57.0" layoutY="530.0" prefWidth="260.0" wrapText="true" />
                    </children>
                </AnchorPane>
            </children>
        </AnchorPane>
    </children>
</StackPane>

