<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1250.0" stylesheets="@style.css" styleClass="home-page-bg"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.AboutController">

    <!-- Sidebar Navigation -->
    <VBox prefWidth="168.0" styleClass="dashboard-sidebar" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <padding><Insets top="20" left="10" right="10" bottom="20" /></padding>
        <spacing>15</spacing>
        <children>
            <!-- Navigation Items -->
            <Button text="🏠 Home" prefWidth="150" onAction="#onNavHome" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button fx:id="productsBtn" text="📦 Products" prefWidth="150" onAction="#onProductsClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="💰 Sales" prefWidth="150" onAction="#onSalesClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="📥 Restock" prefWidth="150" onAction="#onRestockClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="👥 Customers" prefWidth="150" onAction="#onCustomersClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="📊 Reports" prefWidth="150" onAction="#onReportsClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />

            <Separator />

            <Button text="ℹ️ About" prefWidth="150" onAction="#onProfileClick" styleClass="sidebar-btn-active" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
        </children>
    </VBox>

    <!-- Header -->
    <HBox prefHeight="60.0" styleClass="dashboard-header" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets left="30" right="30" top="15" bottom="15" /></padding>
        <spacing>30</spacing>
        <alignment>CENTER_LEFT</alignment>
        <children>
            <Button text="⬅ Back to Home" onAction="#onNavHome" prefWidth="130" prefHeight="40" textAlignment="CENTER" contentDisplay="CENTER" textFill="WHITE" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 0; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-width: 0; -fx-border-radius: 6; -fx-effect: dropshadow(gaussian, rgba(37, 99, 235, 0.4), 8, 0, 0, 2);">
                <font><Font name="System Bold" size="13"/></font>
            </Button>
            <Label text="About" styleClass="dashboard-title" HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" text="Welcome, Admin" styleClass="dashboard-welcome" />
            <Button text="LOGOUT" onAction="#onLogout" prefWidth="100" prefHeight="35" textAlignment="CENTER" contentDisplay="CENTER" textFill="WHITE" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 900; -fx-padding: 0; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-width: 0; -fx-border-radius: 6; -fx-effect: dropshadow(gaussian, rgba(220, 38, 38, 0.4), 8, 0, 0, 2);">
                <font><Font name="System Bold" size="12"/></font>
            </Button>
        </children>
    </HBox>

    <!-- Main Content -->
    <VBox spacing="30" styleClass="dashboard-main" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets left="40" right="40" top="40" bottom="40" /></padding>

        <!-- App Features Section -->
        <AnchorPane VBox.vgrow="ALWAYS" styleClass="content-card" style="-fx-background-color: #161616; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 5);">
            <VBox spacing="20">
                <Label text="🚀 App Features" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                <Separator style="-fx-background-color: #333;" />
                <VBox spacing="10">
                    <Label text="• Modern &amp; Clean UI Dashboard for Desktop" style="-fx-font-size: 16; -fx-text-fill: #a0aec0;" />
                    <Label text="• Comprehensive Inventory &amp; Stock Management" style="-fx-font-size: 16; -fx-text-fill: #a0aec0;" />
                    <Label text="• Advanced Sales &amp; Cart System with Billing" style="-fx-font-size: 16; -fx-text-fill: #a0aec0;" />
                    <Label text="• Dynamic Customer Profiles and Outstanding Tracking" style="-fx-font-size: 16; -fx-text-fill: #a0aec0;" />
                    <Label text="• Smart Restocking and Business Reporting" style="-fx-font-size: 16; -fx-text-fill: #a0aec0;" />
                </VBox>
            </VBox>
        </AnchorPane>

        <!-- Developer Information Section -->
        <AnchorPane VBox.vgrow="ALWAYS" styleClass="content-card" style="-fx-background-color: #161616; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 5);">
            <VBox spacing="20">
                <Label text="👨‍💻 Developer Information" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                <Separator style="-fx-background-color: #333;" />
                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Names:" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-pref-width: 100;" />
                        <VBox spacing="5">
                            <Label text="Md.Nahidul Islam" style="-fx-font-size: 16; -fx-text-fill: #f5f5f5; -fx-font-weight: bold;" />
                            <Label text="Md.Mahidul islam" style="-fx-font-size: 16; -fx-text-fill: #f5f5f5; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Institution:" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-pref-width: 100;" />
                        <Label text="BUET" style="-fx-font-size: 16; -fx-text-fill: #f5f5f5; -fx-font-weight: bold;" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Software:" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-pref-width: 100;" />
                        <Label text="Shop Master - Modern Sales App" style="-fx-font-size: 16; -fx-text-fill: #f5f5f5; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>
            </VBox>
        </AnchorPane>

    </VBox>
</AnchorPane>
