<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="750.0" prefWidth="1400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.HomeLivingController">

    <!-- Top Bar -->
    <HBox layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" styleClass="homeliving-topbar" alignment="CENTER_LEFT" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30" right="30" top="15" bottom="15" />
        </padding>
        <Label text="🏡 Home &amp; Living" styleClass="homeliving-brand" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="➕ Add Product" onAction="#onToggleAddProduct" styleClass="admin-add-btn">
            <HBox.margin>
                <Insets right="15" />
            </HBox.margin>
        </Button>
        <Button text="🛒 Cart" onAction="#onOpenCart" styleClass="homeliving-cart-btn">
            <HBox.margin>
                <Insets right="30" />
            </HBox.margin>
        </Button>
        <Button text="🏠 Back to Home" onAction="#onBackToHome" styleClass="homeliving-back-btn" />
    </HBox>

    <!-- Content Area -->
    <ScrollPane layoutY="70.0" prefWidth="1000.0" prefHeight="630.0" fitToWidth="true" styleClass="homeliving-scroll" hbarPolicy="NEVER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0" AnchorPane.bottomAnchor="0.0">
        <VBox spacing="25">
            <padding>
                <Insets left="30" right="30" top="25" bottom="25" />
            </padding>

            <!-- Title -->
            <VBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Transform Your Home" styleClass="homeliving-page-title" />
                <Rectangle width="80" height="4" styleClass="homeliving-title-underline" />
            </VBox>

            <!-- Filter Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="homeliving-filter-bar">
                <padding>
                    <Insets top="12" bottom="12" left="15" right="15" />
                </padding>
                <Label text="Shop By Category:" styleClass="homeliving-filter-label" />
                <Button fx:id="btnAll" text="All Products" onAction="#onFilterAll" styleClass="homeliving-filter homeliving-filter-active" />
                <Button fx:id="btnFurniture" text="🛋️ Furniture" onAction="#onFilterFurniture" styleClass="homeliving-filter" />
                <Button fx:id="btnDecor" text="🖼️ Decor" onAction="#onFilterDecor" styleClass="homeliving-filter" />
                <Button fx:id="btnKitchen" text="🍳 Kitchen" onAction="#onFilterKitchen" styleClass="homeliving-filter" />
            </HBox>

            <!-- Product Grid - 12 Home & Living Products -->
            <GridPane fx:id="productGrid" hgap="20" vgap="20" alignment="CENTER">

                <!-- Row 1: Furniture Products -->
                <!-- Product 1 - Sofa Set -->
                <VBox userData="Furniture" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🛋️" style="-fx-font-size: 64px;" />
                        <Label text="🔥 20% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="3-Seater Sofa Set" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳32,000 (was ৳40,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Product 2 - Dining Table -->
                <VBox userData="Furniture" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🪑" style="-fx-font-size: 64px;" />
                        <Label text="🔥 25% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Dining Table 6-Seater" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳22,500 (was ৳30,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Product 3 - Bed Frame -->
                <VBox userData="Furniture" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🛏️" style="-fx-font-size: 64px;" />
                        <Label text="🔥 18% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="King Size Bed Frame" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳24,600 (was ৳30,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Row 2: Decor Products -->
                <!-- Product 4 - Wall Art -->
                <VBox userData="Decor" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🖼️" style="-fx-font-size: 64px;" />
                        <Label text="🔥 30% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Modern Wall Art Set" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳2,800 (was ৳4,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Product 5 - Table Lamp -->
                <VBox userData="Decor" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="💡" style="-fx-font-size: 64px;" />
                        <Label text="🔥 22% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Designer Table Lamp" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳1,560 (was ৳2,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Product 6 - Curtains -->
                <VBox userData="Decor" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🪟" style="-fx-font-size: 64px;" />
                        <Label text="🔥 25% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Blackout Curtains Pair" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳3,000 (was ৳4,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Row 3: Kitchen Products -->
                <!-- Product 7 - Cookware Set -->
                <VBox userData="Kitchen" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🍳" style="-fx-font-size: 64px;" />
                        <Label text="🔥 28% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Non-Stick Cookware Set" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳3,600 (was ৳5,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Product 8 - Blender -->
                <VBox userData="Kitchen" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🥤" style="-fx-font-size: 64px;" />
                        <Label text="🔥 20% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Multi-Speed Blender" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳4,000 (was ৳5,000)" styleClass="product-price-discount" wrapText="true" maxWidth="260" alignment="CENTER" />
                </VBox>

                <!-- Product 9 - Knife Set -->
                <VBox userData="Kitchen" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🔪" style="-fx-font-size: 64px;" />
                        <Label text="🔥 25% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Professional Knife Set" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳2250  (was ৳3000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Row 4: Mixed Premium Products -->
                <!-- Product 10 - Wardrobe -->
                <VBox userData="Furniture" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🚪" style="-fx-font-size: 64px;" />
                        <Label text="🔥 22% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="3-Door Wardrobe" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳27300  (was ৳35000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 11 - Rug -->
                <VBox userData="Decor" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="🧶" style="-fx-font-size: 64px;" />
                        <Label text="🔥 30% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Persian Style Rug 6x9" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳7000  (was ৳10000)" styleClass="product-price-discount" />
                </VBox>

                <!-- Product 12 - Coffee Maker -->
                <VBox userData="Kitchen" styleClass="product-card" prefWidth="290" prefHeight="360" alignment="TOP_CENTER" spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="3">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15" />
                    </padding>
                    <StackPane prefWidth="260" prefHeight="200" styleClass="product-image">
                        <Label text="☕" style="-fx-font-size: 64px;" />
                        <Label text="🔥 25% OFF" styleClass="product-discount-badge" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin>
                                <Insets top="10" right="10" />
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="Automatic Coffee Maker" styleClass="product-name" wrapText="true" maxWidth="260" alignment="CENTER" />
                    <Label text="৳5625  (was ৳7500)" styleClass="product-price-discount" />
                </VBox>

            </GridPane>

            <!-- Status -->
            <Label fx:id="statusLabel" text="🏡 12 Home &amp; Living Products - All with Amazing Discounts!" styleClass="homeliving-status" />

        </VBox>
    </ScrollPane>

    <!-- Background Overlay (dims the page when panel is open) - MUST be after ScrollPane to appear on top -->
    <StackPane fx:id="overlayPane" managed="false" visible="false" styleClass="overlay-bg" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    </StackPane>

    <!-- Add Product Panel (Hidden by default) - MUST be after Overlay to appear on top of everything -->
    <VBox fx:id="addProductPanel" alignment="CENTER" managed="false" prefHeight="520" prefWidth="500" spacing="0" styleClass="add-product-panel" visible="false" AnchorPane.leftAnchor="250.0" AnchorPane.topAnchor="90.0">

        <!-- Panel Header (Fixed) -->
        <HBox alignment="CENTER" styleClass="add-product-header">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label styleClass="add-product-title" text="➕ Add New Home &amp; Living Item" />
        </HBox>

        <!-- Scrollable Content -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="add-product-scroll" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets bottom="20" left="30" right="30" top="15" />
                </padding>

                <!-- Image Preview -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane prefHeight="140" prefWidth="180" styleClass="image-preview-box">
                        <javafx.scene.image.ImageView fx:id="previewImageView" fitHeight="130" fitWidth="170" preserveRatio="true" />
                        <Label fx:id="noImageLabel" text="📷 No Image Selected" styleClass="no-image-label" />
                    </StackPane>
                    <Button onAction="#onChooseImage" styleClass="choose-image-btn" text="📁 Choose Image" />
                </VBox>

                <!-- Product Name -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Name:" />
                    <TextField fx:id="productNameField" prefHeight="40" prefWidth="420" promptText="Enter product name..." styleClass="form-textfield" />
                </VBox>

                <!-- Product Price -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Product Price (৳):" />
                    <TextField fx:id="productPriceField" prefHeight="40" prefWidth="420" promptText="Enter price (e.g., 5000)" styleClass="form-textfield" />
                </VBox>

                <!-- Stock Quantity -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Stock Quantity:" />
                    <TextField fx:id="stockQuantityField" prefHeight="40" prefWidth="420" promptText="Enter stock quantity (e.g., 10)" styleClass="form-textfield" />
                </VBox>

                <!-- Product Category -->
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label styleClass="form-label" text="Category:" />
                    <javafx.scene.control.ComboBox fx:id="categoryComboBox" prefHeight="40" prefWidth="420" promptText="Select Category" styleClass="form-combobox" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="20">
                    <padding>
                        <Insets top="15" />
                    </padding>
                    <Button onAction="#onCancelAddProduct" styleClass="cancel-btn" text="❌ Cancel" />
                    <Button onAction="#onSubmitProduct" styleClass="submit-btn" text="✓ Add Product" />
                </HBox>

                <!-- Status Message -->
                <Label fx:id="addProductStatus" styleClass="add-product-status" text="" />
            </VBox>
        </ScrollPane>
    </VBox>

</AnchorPane>

