<AnchorPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.HomeLivingController">

    <!-- Top Bar -->
    <HBox layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" styleClass="homeliving-topbar" alignment="CENTER_LEFT" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30" right="30" top="15" bottom="15" />
        </padding>
        <Label text="🏡 Home &amp; Living" styleClass="homeliving-brand" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="🛒 Cart" onAction="#onOpenCart" styleClass="homeliving-cart-btn">
