                <Label text="Shop By Category:" styleClass="homeliving-filter-label" />
                <Button fx:id="btnAll" text="All Products" onAction="#onFilterAll" styleClass="homeliving-filter homeliving-filter-active" />
                <Button fx:id="btnFurniture" text="🛋️ Furniture" onAction="#onFilterFurniture" styleClass="homeliving-filter" />
                <Button fx:id="btnDecor" text="🖼️ Decor" onAction="#onFilterDecor" styleClass="homeliving-filter" />
                <Button fx:id="btnKitchen" text="🍳 Kitchen" onAction="#onFilterKitchen" styleClass="homeliving-filter" />
