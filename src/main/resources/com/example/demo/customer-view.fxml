<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.CustomerController" stylesheets="@style.css">

    <AnchorPane prefHeight="750.0" prefWidth="1250.0" styleClass="home-page-bg">
        <!-- Sidebar Navigation -->
        <VBox prefWidth="168.0" styleClass="dashboard-sidebar" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding><Insets top="20" left="10" right="10" bottom="20" /></padding>
            <spacing>15</spacing>
            <children>
                <Circle radius="20" fill="#ffffff" styleClass="sidebar-logo" />
                <Button text="🏠 Home" prefWidth="150" onAction="#onNavHome" styleClass="sidebar-btn" />
                <Button text="📦 Products" prefWidth="150" onAction="#onProductsClick" styleClass="sidebar-btn" />
                <Button text="💰 Sales" prefWidth="150" onAction="#onSalesClick" styleClass="sidebar-btn" />
                <Button text="📥 Restock" prefWidth="150" onAction="#onRestockClick" styleClass="sidebar-btn" />
                <Button text="👥 Customers" prefWidth="150" onAction="#onCustomersClick" styleClass="sidebar-btn-active" />
                <Button text="📊 Reports" prefWidth="150" onAction="#onReportsClick" styleClass="sidebar-btn" />
                <Separator />
                <Button text="⚙️ Settings" prefWidth="150" onAction="#onProfileClick" styleClass="sidebar-btn" />
            </children>
        </VBox>

        <!-- Header -->
        <HBox prefHeight="60.0" styleClass="dashboard-header" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
            <padding><Insets left="30" right="30" top="15" bottom="15" /></padding>
            <spacing>30</spacing>
            <alignment>CENTER_LEFT</alignment>
            <children>
                <Button text="⬅ Back to Home" onAction="#onNavHome" styleClass="action-btn-blue" />
                <Label text="Customers" styleClass="dashboard-title" HBox.hgrow="ALWAYS" />
                <Label fx:id="userLabel" text="Welcome, Admin" styleClass="dashboard-welcome" />
            </children>
        </HBox>

        <!-- Main Content -->
        <VBox spacing="20" styleClass="dashboard-main" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
             <padding><Insets left="20" right="20" top="20" bottom="20" /></padding>

             <!-- Toolbar -->
             <HBox spacing="15" alignment="CENTER_LEFT">
                 <TextField fx:id="searchField" promptText="Search customers..." prefWidth="300" styleClass="search-field"/>
                 <AnchorPane HBox.hgrow="ALWAYS" />
             </HBox>

             <!-- Table -->
             <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                 <columns>
                     <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
                     <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="150"/>
                     <TableColumn fx:id="emailColumn" text="Email Address" prefWidth="200"/>
                     <TableColumn fx:id="typeColumn" text="Customer Type" prefWidth="120"/>
                     <TableColumn fx:id="dueColumn" text="Due Balance" prefWidth="120"/>
                     <TableColumn fx:id="actionColumn" text="Actions" prefWidth="100"/>
                 </columns>
                 <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                 </columnResizePolicy>
             </TableView>
        </VBox>
    </AnchorPane>

    <!-- Modal Overlay -->
    <AnchorPane fx:id="modalOverlay" visible="false" style="-fx-background-color: rgba(0,0,0,0.5);">
         <children>
             <VBox layoutX="0" layoutY="0" maxWidth="500" maxHeight="650" style="-fx-background-color: #101010; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.55), 12, 0, 0, 0);"
                   AnchorPane.leftAnchor="375.0" AnchorPane.topAnchor="50.0"> <!-- Centered roughly -->

                 <!-- Modal Header -->
                 <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                     <Label fx:id="modalTitle" text="Add Customer" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #f5f5f5;" HBox.hgrow="ALWAYS" />
                     <AnchorPane HBox.hgrow="ALWAYS" />
                     <Button text="✕" onAction="#onCancelModal" style="-fx-background-color: transparent; -fx-text-fill: #f5f5f5; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" />
                 </HBox>

                 <!-- Modal Body -->
                 <VBox spacing="15" style="-fx-padding: 20;">
                     <VBox spacing="5">
                         <Label text="Customer Name *" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;"/>
                         <TextField fx:id="nameField" promptText="Enter customer name" style="-fx-pref-height: 35;"/>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Phone Number *" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;"/>
                         <HBox spacing="10">
                             <TextField text="+880" editable="false" prefWidth="60" style="-fx-pref-height: 35; -fx-background-color: #111111; -fx-text-fill: #f5f5f5; -fx-font-weight: bold;"/>
                             <TextField fx:id="phoneField" promptText="Enter phone number" HBox.hgrow="ALWAYS" style="-fx-pref-height: 35;"/>
                         </HBox>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Email Address" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;"/>
                         <TextField fx:id="emailField" promptText="Enter email address" style="-fx-pref-height: 35;"/>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Address" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;"/>
                         <TextArea fx:id="addressArea" promptText="Enter address" prefRowCount="3" wrapText="true" style="-fx-pref-height: 80;"/>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Customer Type" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;"/>
                         <ComboBox fx:id="typeCombo" promptText="Select type" maxWidth="Infinity" style="-fx-pref-height: 35;"/>
                     </VBox>

                     <HBox spacing="10" alignment="CENTER_LEFT">
                         <Label text="Due Balance" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;"/>
                         <ToggleButton fx:id="dueBalanceToggle" text="Enable Due" onAction="#onDueToggle" styleClass="due-toggle-black" />
                         <TextField fx:id="dueBalanceAmountField" promptText="0.00" prefWidth="100" disable="true"/>
                     </HBox>
                 </VBox>

                 <!-- Modal Footer -->
                 <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15; -fx-border-color: #333333; -fx-border-width: 1 0 0 0;">
                      <Button text="Cancel" onAction="#onCancelModal" style="-fx-background-color: #111111; -fx-text-fill: #f5f5f5; -fx-font-weight: bold; -fx-pref-width: 100; -fx-pref-height: 35;"/>
                      <Button text="Save Customer" onAction="#onSaveCustomer" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-pref-width: 140; -fx-pref-height: 35;"/>
                 </HBox>
             </VBox>
         </children>
    </AnchorPane>

</StackPane>

