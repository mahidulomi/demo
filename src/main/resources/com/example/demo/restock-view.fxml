<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="850.0" prefWidth="1100.0" style="-fx-background-color: #000000;" stylesheets="@sales-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.RestockController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="60.0" spacing="20" style="-fx-background-color: #111111; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding><Insets left="20" /></padding>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f5f5f5;" text="Restock Item" />
         <Button onAction="#onBackClick" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #f5f5f5; -fx-font-size: 14px; -fx-font-weight: bold;" text="← Home" />
    </HBox>

    <VBox spacing="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
        <padding><Insets bottom="20" left="20" right="20" top="10" /></padding>

        <!-- Stats Cards -->
        <HBox spacing="15">
             <!-- Card 1: Low Stock (Orange/Peach) -->
             <HBox  HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #101010; -fx-background-radius: 5; -fx-border-color: #FFB74D; -fx-border-radius: 5; -fx-padding: 15;">
                 <Label fx:id="lowStockCountLabel" style="-fx-background-color: #EF6C00; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 4; -fx-font-size: 18;" text="0" />
                 <Label text="Low Stock Items" style="-fx-text-fill: #EF6C00; -fx-font-weight: bold;" />
             </HBox>

             <!-- Card 2: Out of Stock (Red/Pink) -->
             <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #101010; -fx-background-radius: 5; -fx-border-color: #E57373; -fx-border-radius: 5; -fx-padding: 15;">
                 <Label fx:id="outOfStockCountLabel" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 4; -fx-font-size: 18;" text="0" />
                 <Label text="Out of Stock Items" style="-fx-text-fill: #C62828; -fx-font-weight: bold;" />
             </HBox>

             <!-- Card 3: Total Items (Blue) -->
             <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #101010; -fx-background-radius: 5; -fx-border-color: #64B5F6; -fx-border-radius: 5; -fx-padding: 15;">
                 <Label fx:id="totalItemsCountLabel" style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 4; -fx-font-size: 18;" text="0" />
                 <Label text="Total Items" style="-fx-text-fill: #1565C0; -fx-font-weight: bold;" />
             </HBox>

             <!-- Card 4: Recent Restocks (Green) -->
             <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #101010; -fx-background-radius: 5; -fx-border-color: #81C784; -fx-border-radius: 5; -fx-padding: 15;">
                 <Label fx:id="recentRestocksCountLabel" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 4; -fx-font-size: 18;" text="0" />
                 <Label text="Recent Restocks" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold;" />
             </HBox>
        </HBox>

        <!-- Restock Form & Table Container -->

        <Label text="Restock Item" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />

        <VBox style="-fx-background-color: #101010; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.45), 6, 0, 0, 2); -fx-border-color: #333333; -fx-border-radius: 5; -fx-border-width: 1;" VBox.vgrow="NEVER">

            <Label text="Restock Information" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f5f5f5; -fx-background-color: #171717; -fx-padding: 10; -fx-background-radius: 5 5 0 0; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;" maxWidth="Infinity" />

            <VBox spacing="15" style="-fx-padding: 20 30 20 30;">
                <!-- Row 1: Item Name -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label text="Item Name:" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                    <ComboBox fx:id="itemComboBox" promptText="Select Item" prefWidth="300" style="-fx-background-color: #111111; -fx-background-radius: 3; -fx-border-color: #333333; -fx-border-radius: 3;" />
                </HBox>

                <!-- Row 2: Quantity -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label text="Quantity Restocked:" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                    <TextField fx:id="quantityField" promptText="Enter Quantity" prefWidth="300" style="-fx-background-color: #111111; -fx-background-radius: 3; -fx-border-color: #333333; -fx-border-radius: 3; -fx-text-fill: #f5f5f5;" />
                </HBox>

                <!-- Row 3: Date -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label text="Restock Date:" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                    <DatePicker fx:id="restockDatePicker" prefWidth="300" style="-fx-background-color: #111111; -fx-background-radius: 3; -fx-border-color: #333333; -fx-border-radius: 3;" />
                </HBox>

                <!-- Row 4: Price -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label text="Purchase Price:" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                    <TextField fx:id="purchasePriceField" promptText="Enter Price (per unit)" prefWidth="300" style="-fx-background-color: #111111; -fx-background-radius: 3; -fx-border-color: #333333; -fx-border-radius: 3; -fx-text-fill: #f5f5f5;" />
                </HBox>

                <!-- Row 5: Notes -->
                <HBox alignment="TOP_LEFT" spacing="20">
                    <Label text="Restock Notes:" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />
                    <TextArea fx:id="notesArea" promptText="Add any notes..." prefWidth="600" prefHeight="80" wrapText="true" style="-fx-background-color: #111111; -fx-background-radius: 3; -fx-border-color: #333333; -fx-border-radius: 3; -fx-text-fill: #f5f5f5;" />
                </HBox>

                <!-- Status Label -->
                 <Label fx:id="statusLabel" text="" style="-fx-font-style: italic; -fx-font-size: 13px;" />

                <!-- Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 15 0 0 0; -fx-border-color: #333333; -fx-border-width: 1 0 0 0;">
                    <Button text="Cancel" onAction="#onCancel" style="-fx-background-color: #1b1b1b; -fx-text-fill: #f5f5f5; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 20;" />
                    <Button text="Add Restock" onAction="#onAddRestock" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-effect: dropshadow(three-pass-box, rgba(52, 152, 219, 0.3), 5, 0, 0, 2);" />
                </HBox>
            </VBox>
        </VBox>

        <Label text="Recent Restock Entries" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f5f5f5;" />

        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #101010; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.45), 6, 0, 0, 2);">
             <columns>
                 <TableColumn fx:id="colItemName" text="Item Name" prefWidth="200" />
                 <TableColumn fx:id="colQty" text="Restocked Qty" prefWidth="100" style="-fx-alignment: CENTER;" />
                 <TableColumn fx:id="colPrice" text="Purchase Price" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;" />
                 <TableColumn fx:id="colDate" text="Restock Date" prefWidth="150" />
                 <TableColumn fx:id="colAddedBy" text="Added By" prefWidth="120" />
             </columns>
             <columnResizePolicy>
                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
             </columnResizePolicy>
             <placeholder>
                <Label text="No recent restock entries available." />
            </placeholder>
        </TableView>

    </VBox>

</AnchorPane>

