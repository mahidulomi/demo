<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<!--suppress XmlPathReference, XmlUnboundNsPrefix, XmlSchemaValidation -->
<AnchorPane prefHeight="750.0" prefWidth="1250.0" styleClass="root" stylesheets="@sales-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.SalesController">

    <!-- Header -->
    <HBox layoutX="0.0" layoutY="0.0" prefHeight="70.0" spacing="30" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>
        <children>
            <Label styleClass="header-label" text="💰 Sales Dashboard" />
            <Label fx:id="totalStockLabel" text="Total Stock: 0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 5 0 0 20;" />
            <Button onAction="#onBackClick" styleClass="back-button" text="← Back" />
        </children>
    </HBox>

    <!-- Main Content -->
    <HBox layoutX="0.0" layoutY="80.0" prefHeight="670.0" prefWidth="1400.0" spacing="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0">
        <padding><Insets bottom="20" left="20" right="20" top="10" /></padding>

        <!-- Left Side: Products -->
        <VBox prefWidth="900.0" spacing="15" HBox.hgrow="ALWAYS">
            <!-- Search -->
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10">
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="🔍 Search Product..." styleClass="search-field" />
                <Button onAction="#onCategoryClick" prefWidth="80.0" styleClass="category-button" text="📦 All" />
                <Button onAction="#onCategoryClick" prefWidth="100.0" styleClass="category-button" text="💄 Beauty" />
                <Button onAction="#onCategoryClick" prefWidth="120.0" styleClass="category-button" text="📱 Electronics" />
                <Button onAction="#onCategoryClick" prefWidth="100.0" styleClass="category-button" text="🏠 Home" />
                <Button onAction="#onCategoryClick" prefWidth="100.0" styleClass="category-button" text="👗 Fashion" />
            </HBox>

            <!-- Products Grid (TilePane for responsive layout) -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <TilePane fx:id="productsTilePane" hgap="25" vgap="25" prefColumns="3" tileAlignment="TOP_CENTER" alignment="TOP_CENTER" style="-fx-padding: 15;">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </TilePane>
            </ScrollPane>
        </VBox>

        <!-- Right Side: Cart -->
        <VBox prefWidth="350.0" spacing="15" styleClass="cart-panel" minWidth="300">
            <Label text="🛒 Shopping Cart" styleClass="cart-header" />

            <!-- Cart Items -->
            <ScrollPane fitToWidth="true" prefHeight="350.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <VBox fx:id="cartItemsContainer" spacing="10">
                    <padding><Insets top="5" right="5" bottom="5" left="5" /></padding>
                </VBox>
            </ScrollPane>

            <!-- Summary -->
            <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Subtotal:" styleClass="summery-label" prefWidth="100" />
                    <Label fx:id="subtotalLabel" text="Tk.0.00" style="-fx-font-weight: bold;" alignment="CENTER_RIGHT" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: #ddd; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                    <Label text="Total:" styleClass="total-label" prefWidth="100" />
                    <Label fx:id="totalLabel" text="Tk.0.00" styleClass="total-label" alignment="CENTER_RIGHT" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Buttons -->
            <HBox spacing="10" prefHeight="50.0">
                <Button text="✓ Confirm Sale" onAction="#onConfirmSale" prefWidth="220.0" styleClass="confirm-button" HBox.hgrow="ALWAYS" />
                <Button text="✕ Clear Cart" onAction="#onClearCart" prefWidth="220.0" styleClass="clear-button" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </HBox>

</AnchorPane>

