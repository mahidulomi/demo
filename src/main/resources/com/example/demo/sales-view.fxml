<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--suppress XmlPathReference, XmlUnboundNsPrefix, XmlSchemaValidation -->
<StackPane fx:id="rootStackPane" prefHeight="750.0" prefWidth="1250.0" styleClass="root" stylesheets="@sales-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.SalesController">

    <!-- Main Content Layer -->
    <AnchorPane prefHeight="750.0" prefWidth="1250.0" styleClass="root">

        <!-- Header -->
        <HBox layoutX="0.0" layoutY="0.0" prefHeight="70.0" spacing="30" style="-fx-background-color: #1e1e1e; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>
            <children>
                <Label styleClass="header-label" text="💰 Sales Dashboard" style="-fx-font-size: 18; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>
                <Label fx:id="totalStockLabel" text="Total Stock: 0" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-padding: 5 0 0 20;">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>
                <Button onAction="#onBackClick" styleClass="back-button" text="← Back" style="-fx-font-size: 12; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="12"/></font>
                </Button>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox layoutX="0.0" layoutY="80.0" prefHeight="670.0" prefWidth="1400.0" spacing="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0">
            <padding><Insets bottom="20" left="20" right="20" top="10" /></padding>

            <!-- Left Side: Products -->
            <VBox prefWidth="900.0" spacing="15" HBox.hgrow="ALWAYS">
                <!-- Search -->
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10">
                    <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="🔍 Search Product..." styleClass="search-field" style="-fx-font-size: 12;" />
                    <Button onAction="#onCategoryClick" prefWidth="80.0" styleClass="category-button" text="📦 All" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                    <Button onAction="#onCategoryClick" prefWidth="100.0" styleClass="category-button" text="💄 Beauty" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                    <Button onAction="#onCategoryClick" prefWidth="120.0" styleClass="category-button" text="📱 Electronics" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                    <Button onAction="#onCategoryClick" prefWidth="100.0" styleClass="category-button" text="🏠 Home" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                    <Button onAction="#onCategoryClick" prefWidth="100.0" styleClass="category-button" text="👗 Fashion" style="-fx-font-size: 12; -fx-padding: 8 12; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                </HBox>

                <!-- Products Grid (TilePane for responsive layout) -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <TilePane fx:id="productsTilePane" hgap="25" vgap="25" prefColumns="3" tileAlignment="TOP_CENTER" alignment="TOP_CENTER" style="-fx-padding: 15;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </TilePane>
                </ScrollPane>
            </VBox>

            <!-- Right Side: Cart -->
            <VBox prefWidth="350.0" spacing="15" styleClass="cart-panel" minWidth="300">
                <Label text="🛒 Shopping Cart" styleClass="cart-header" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>

                <!-- Cart Items -->
                <ScrollPane fitToWidth="true" prefHeight="350.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <VBox fx:id="cartItemsContainer" spacing="10">
                        <padding><Insets top="5" right="5" bottom="5" left="5" /></padding>
                    </VBox>
                </ScrollPane>

                <!-- Summary -->
                <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #1e1e1e; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 2);">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Subtotal:" styleClass="summery-label" prefWidth="100" style="-fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-font-size: 12;">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <Label fx:id="subtotalLabel" text="Tk.0.00" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 12;" alignment="CENTER_RIGHT" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: #4a5568; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                        <Label text="Total:" styleClass="total-label" prefWidth="100" style="-fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-font-size: 12;">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <Label fx:id="totalLabel" text="Tk.0.00" styleClass="total-label" alignment="CENTER_RIGHT" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 12;"/>
                    </HBox>
                </VBox>

                <!-- Customer Details (Updated) -->
                <VBox spacing="5" style="-fx-padding: 5 0 5 0;">
                     <Label text="Customer Details" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: white;">
                         <font><Font name="System Bold" size="12"/></font>
                     </Label>
                     <Label fx:id="selectedCustomerLabel" text="No Customer Selected" style="-fx-text-fill: #a0aec0; -fx-font-style: italic; -fx-padding: 0 0 5 0; -fx-font-size: 11;" />
                     <Button fx:id="addCustomerButton" text="👤 Add Customer" onAction="#onOpenCustomerModal" styleClass="confirm-button" style="-fx-background-color: #3498db; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 8 15;" maxWidth="Infinity">
                         <font><Font name="System Bold" size="12"/></font>
                     </Button>
                </VBox>

                <!-- Buttons -->
                <HBox spacing="10" prefHeight="50.0">
                    <Button text="✓ Confirm Sale" onAction="#onConfirmSale" maxWidth="Infinity" styleClass="confirm-button" HBox.hgrow="ALWAYS" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 8 15;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                    <Button text="✕ Clear Cart" onAction="#onClearCart" maxWidth="Infinity" styleClass="clear-button" HBox.hgrow="ALWAYS" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 8 15;">
                        <font><Font name="System Bold" size="12"/></font>
                    </Button>
                </HBox>
            </VBox>
        </HBox>

    </AnchorPane>

    <!-- Modal Overlay -->
    <AnchorPane fx:id="modalOverlay" visible="false" style="-fx-background-color: rgba(0,0,0,0.5);">
             <children>
                 <VBox layoutX="0" layoutY="0" maxWidth="500" maxHeight="650" style="-fx-background-color: #1e1e1e; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0); -fx-border-color: #334155; -fx-border-radius: 8;"
                       AnchorPane.leftAnchor="375.0" AnchorPane.topAnchor="50.0"> <!-- Centered roughly -->

                 <!-- Modal Header -->
                 <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
                     <Label fx:id="modalTitle" text="Add Customer" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;">
                         <font><Font name="System Bold" size="18"/></font>
                     </Label>
                     <AnchorPane HBox.hgrow="ALWAYS" />
                     <Button text="X" onAction="#onCancelModal" style="-fx-background-color: transparent; -fx-text-fill: #a0aec0; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" />
                 </HBox>

                 <!-- Modal Body -->
                 <VBox spacing="15" style="-fx-padding: 20;">
                     <VBox spacing="5">
                         <Label text="Customer Name *" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0; -fx-font-size: 12;">
                             <font><Font name="System Bold" size="12"/></font>
                         </Label>
                         <TextField fx:id="nameField" promptText="Enter customer name" style="-fx-pref-height: 35; -fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-border-color: #4a5568; -fx-border-radius: 5; -fx-font-size: 12; -fx-font-weight: bold;">
                             <font><Font name="System Bold" size="12"/></font>
                         </TextField>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Phone Number *" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0; -fx-font-size: 12;">
                             <font><Font name="System Bold" size="12"/></font>
                         </Label>
                         <HBox spacing="10">
                             <TextField text="+880" editable="false" prefWidth="60" style="-fx-pref-height: 35; -fx-background-color: #334155; -fx-text-fill: white; -fx-border-color: #4a5568; -fx-border-radius: 5; -fx-font-size: 12; -fx-font-weight: bold;">
                                 <font><Font name="System Bold" size="12"/></font>
                             </TextField>
                             <TextField fx:id="phoneField" promptText="Enter phone number" HBox.hgrow="ALWAYS" style="-fx-pref-height: 35; -fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-border-color: #4a5568; -fx-border-radius: 5; -fx-font-size: 12; -fx-font-weight: bold;">
                                 <font><Font name="System Bold" size="12"/></font>
                             </TextField>
                         </HBox>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Email Address" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0; -fx-font-size: 12;">
                             <font><Font name="System Bold" size="12"/></font>
                         </Label>
                         <TextField fx:id="emailField" promptText="Enter email address" style="-fx-pref-height: 35; -fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-border-color: #4a5568; -fx-border-radius: 5; -fx-font-size: 12; -fx-font-weight: bold;">
                             <font><Font name="System Bold" size="12"/></font>
                         </TextField>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Address" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0; -fx-font-size: 12;">
                             <font><Font name="System Bold" size="12"/></font>
                         </Label>
                         <TextArea fx:id="addressArea" promptText="Enter address" prefRowCount="3" wrapText="true" style="-fx-pref-height: 80; -fx-control-inner-background: #2d2d2d; -fx-text-fill: white; -fx-border-color: #4a5568; -fx-border-radius: 5; -fx-font-size: 12; -fx-font-weight: bold;">
                             <font><Font name="System Bold" size="12"/></font>
                         </TextArea>
                     </VBox>

                     <VBox spacing="5">
                         <Label text="Customer Type" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0; -fx-font-size: 12;">
                             <font><Font name="System Bold" size="12"/></font>
                         </Label>
                         <ComboBox fx:id="typeCombo" promptText="Select type" maxWidth="Infinity" style="-fx-pref-height: 35; -fx-background-color: #2d2d2d; -fx-border-color: #4a5568; -fx-font-size: 12;"/>
                     </VBox>

                     <HBox spacing="10" alignment="CENTER_LEFT">
                         <Label text="Due Balance" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0; -fx-font-size: 12;">
                             <font><Font name="System Bold" size="12"/></font>
                         </Label>
                         <ToggleButton fx:id="dueBalanceToggle" text="Enable Due" onAction="#onDueToggle" styleClass="due-toggle-black" style="-fx-font-size: 12; -fx-font-weight: bold;">
                             <font><Font name="System Bold" size="12"/></font>
                         </ToggleButton>
                         <TextField fx:id="dueBalanceAmountField" promptText="0.00" prefWidth="100" disable="true" style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;">
                             <font><Font name="System Bold" size="12"/></font>
                         </TextField>
                     </HBox>
                 </VBox>

                 <!-- Modal Footer -->
                 <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15; -fx-border-color: #eee; -fx-border-width: 1 0 0 0;">
                      <Button text="Cancel" onAction="#onCancelModal" style="-fx-background-color: #f5f5f5; -fx-text-fill: #333; -fx-pref-width: 100; -fx-pref-height: 35; -fx-font-size: 12; -fx-font-weight: bold;">
                          <font><Font name="System Bold" size="12"/></font>
                      </Button>
                      <Button text="Save and Select" onAction="#onSaveCustomer" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-pref-width: 140; -fx-pref-height: 35; -fx-font-size: 12; -fx-font-weight: bold;">
                          <font><Font name="System Bold" size="12"/></font>
                      </Button>
                 </HBox>
             </VBox>
         </children>
        </AnchorPane>
</StackPane>
