<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--suppress XmlPathReference, XmlUnboundNsPrefix, XmlSchemaValidation -->
<AnchorPane prefHeight="750.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.SalesController">

    <!-- Header -->
    <HBox layoutX="0.0" layoutY="0.0" prefHeight="70.0" prefWidth="1400.0">
        <padding><Insets left="20" right="20" top="15" bottom="15" /></padding>
        <spacing>30</spacing>
        <children>
            <Label text="💰 Sales" HBox.hgrow="ALWAYS" style="-fx-font-size: 24; -fx-font-weight: bold;" />
            <Button text="← Back" onAction="#onBackClick" />
        </children>
    </HBox>

    <!-- Main Content -->
    <HBox layoutX="0.0" layoutY="70.0" prefHeight="680.0" prefWidth="1400.0" spacing="20">
        <padding><Insets left="15" right="15" top="15" bottom="15" /></padding>

        <!-- Left Side: Products -->
        <VBox prefWidth="900.0" spacing="15">
            <!-- Search -->
            <HBox spacing="10" prefHeight="50.0">
                <TextField fx:id="searchField" prefHeight="40.0" promptText="Search Product..." prefWidth="300.0" />
                <Button text="📦 All" onAction="#onCategoryClick" prefWidth="80.0" />
                <Button text="💄 Beauty" onAction="#onCategoryClick" prefWidth="100.0" />
                <Button text="📱 Electronics" onAction="#onCategoryClick" prefWidth="120.0" />
                <Button text="🏠 Home" onAction="#onCategoryClick" prefWidth="100.0" />
                <Button text="👗 Fashion" onAction="#onCategoryClick" prefWidth="100.0" />
            </HBox>

            <!-- Products Grid -->
            <ScrollPane fitToWidth="true" prefHeight="600.0">
                <GridPane fx:id="productsGrid" hgap="15" vgap="15">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </GridPane>
            </ScrollPane>
        </VBox>

        <!-- Right Side: Cart -->
        <VBox prefWidth="480.0" spacing="15">
            <Label text="🛒 Shopping Cart" style="-fx-font-size: 18; -fx-font-weight: bold;" />

            <!-- Cart Items -->
            <ScrollPane fitToWidth="true" prefHeight="350.0">
                <VBox fx:id="cartItemsContainer" spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10" /></padding>
                </VBox>
            </ScrollPane>

            <!-- Summary -->
            <VBox spacing="10">
                <HBox spacing="200">
                    <Label text="Subtotal:" />
                    <Label fx:id="subtotalLabel" text="₹0.00" />
                </HBox>
                <HBox spacing="200">
                    <Label text="Discount:" />
                    <Label fx:id="discountLabel" text="₹0.00" />
                </HBox>
                <HBox spacing="200">
                    <Label text="Total:" style="-fx-font-weight: bold;" />
                    <Label fx:id="totalLabel" text="₹0.00" style="-fx-font-weight: bold;" />
                </HBox>
            </VBox>

            <!-- Buttons -->
            <HBox spacing="10" prefHeight="50.0">
                <Button text="✓ Confirm Sale" onAction="#onConfirmSale" prefWidth="220.0" />
                <Button text="✕ Clear Cart" onAction="#onClearCart" prefWidth="220.0" />
            </HBox>
        </VBox>
    </HBox>

</AnchorPane>

