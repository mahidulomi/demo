<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ProductListController">

    <!-- Header -->
    <VBox layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="1000.0" styleClass="dashboard-header">
        <padding><Insets left="30" right="30" top="15" bottom="15" /></padding>
        <spacing>10</spacing>
        <children>
            <HBox spacing="30" alignment="CENTER_LEFT">
                <Label fx:id="categoryLabel" text="Beauty Products" styleClass="dashboard-title" HBox.hgrow="ALWAYS" />
                <Button text="← Back" onAction="#onBackClick" styleClass="logout-btn" />
            </HBox>
        </children>
    </VBox>

    <!-- Products List -->
    <ScrollPane layoutX="0.0" layoutY="80.0" prefHeight="620.0" prefWidth="1000.0" fitToWidth="true">
        <VBox fx:id="productsListContainer" spacing="10" styleClass="products-container">
            <padding><Insets left="20" right="20" top="20" bottom="20" /></padding>
        </VBox>
    </ScrollPane>

</AnchorPane>

