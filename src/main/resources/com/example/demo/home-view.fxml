<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1250.0" stylesheets="@style.css" styleClass="home-page-bg"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.HomeController">

    <!-- Sidebar Navigation -->
    <VBox prefWidth="168.0" styleClass="dashboard-sidebar" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <padding><Insets top="20" left="10" right="10" bottom="20" /></padding>
        <spacing>15</spacing>
        <children>
            <!-- Logo -->
            <Circle radius="20" fill="#ffffff" styleClass="sidebar-logo" />

            <!-- Navigation Items -->
            <Button text="🏠 Home" prefWidth="150" onAction="#onNavHome" styleClass="sidebar-btn-active" />
            <Button fx:id="productsBtn" text="📦 Products" prefWidth="150" onAction="#onProductsClick" styleClass="sidebar-btn" />
            <Button text="💰 Sales" prefWidth="150" onAction="#onSalesClick" styleClass="sidebar-btn" />
            <Button text="📥 Restock" prefWidth="150" onAction="#onRestockClick" styleClass="sidebar-btn" />
            <Button text="👥 Customers" prefWidth="150" onAction="#onCustomersClick" styleClass="sidebar-btn" />
            <Button text="📊 Reports" prefWidth="150" onAction="#onReportsClick" styleClass="sidebar-btn" />

            <Separator />

            <Button text="⚙️ Settings" prefWidth="150" onAction="#onProfileClick" styleClass="sidebar-btn" />
        </children>
    </VBox>

    <!-- Header -->
    <HBox prefHeight="60.0" styleClass="dashboard-header" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets left="30" right="30" top="15" bottom="15" /></padding>
        <spacing>30</spacing>
        <alignment>CENTER_LEFT</alignment>
        <children>
            <Label text="Dashboard" styleClass="dashboard-title" HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" text="Welcome, Admin" styleClass="dashboard-welcome" />
            <Button text="Logout" onAction="#onLogout" styleClass="logout-btn" />
        </children>
    </HBox>

    <!-- Main Content -->
    <VBox spacing="20" styleClass="dashboard-main" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets left="20" right="20" top="20" bottom="20" /></padding>

        <!-- Stats Cards Row -->
        <HBox spacing="20" prefHeight="120.0" styleClass="dashboard-stats-row">
            <!-- Today's Sales -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-green">
                <Label layoutX="20" layoutY="15" text="Today's Sales" styleClass="stat-label" />
                <Label fx:id="todaysSalesLabel" layoutX="20" layoutY="50" text="₹0.00" styleClass="stat-value" />
            </AnchorPane>

            <!-- Total Products -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-blue">
                <Label layoutX="20" layoutY="15" text="Total Products" styleClass="stat-label" />
                <Label fx:id="totalProductsLabel" layoutX="20" layoutY="50" text="0" styleClass="stat-value" />
            </AnchorPane>

            <!-- Low Stock Alert -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-red">
                <Label layoutX="20" layoutY="15" text="Low Stock Alert" styleClass="stat-label" />
                <Label fx:id="lowStockLabel" layoutX="20" layoutY="50" text="0 Items" styleClass="stat-value" />
            </AnchorPane>

            <!-- Total Sales -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-orange">
                <Label layoutX="20" layoutY="15" text="Total Sales" styleClass="stat-label" />
                <Label fx:id="totalSalesLabel" layoutX="20" layoutY="50" text="₹0.00" styleClass="stat-value" />
            </AnchorPane>
        </HBox>

        <!-- Content Area: Full Width Sales Overview -->
        <AnchorPane prefHeight="350.0" VBox.vgrow="ALWAYS" styleClass="content-card">
            <Label layoutX="20" layoutY="15" text="Sales Overview" styleClass="section-title" />
            <AreaChart fx:id="salesChart" layoutX="10.0" layoutY="45.0" prefHeight="280.0" prefWidth="660.0" legendVisible="false" verticalGridLinesVisible="false" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="45.0">
                <xAxis>
                    <CategoryAxis fx:id="xAxis" side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxis" side="LEFT" />
                </yAxis>
            </AreaChart>
        </AnchorPane>


        <Label fx:id="statusLabel" text="" styleClass="home-status" />
    </VBox>

</AnchorPane>
