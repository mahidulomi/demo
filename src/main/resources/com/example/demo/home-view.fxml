<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.HomeController">

    <!-- Sidebar Navigation -->
    <VBox layoutX="0.0" layoutY="0.0" prefHeight="800.0" prefWidth="168.0" styleClass="dashboard-sidebar">
        <padding><Insets top="20" left="10" right="10" bottom="20" /></padding>
        <spacing>15</spacing>
        <children>
            <!-- Logo -->
            <Circle radius="20" fill="#ffffff" styleClass="sidebar-logo" />

            <!-- Navigation Items -->
            <Button text="🏠 Home" prefWidth="150" onAction="#onNavHome" styleClass="sidebar-btn-active" />
            <Button fx:id="productsBtn" text="📦 Products" prefWidth="150" onAction="#onProductsClick" styleClass="sidebar-btn" />
            <Button text="💰 Sales" prefWidth="150" onAction="#onSalesClick" styleClass="sidebar-btn" />
            <Button text="👥 Customers" prefWidth="150" onAction="#openFashion" styleClass="sidebar-btn" />
            <Button text="📊 Reports" prefWidth="150" onAction="#onReportsClick" styleClass="sidebar-btn" />

            <Separator />

            <Button text="⚙️ Settings" prefWidth="150" onAction="#onProfileClick" styleClass="sidebar-btn" />
        </children>
    </VBox>

    <!-- Header -->
    <HBox layoutX="168.0" layoutY="0.0" prefHeight="60.0" prefWidth="1112.0" styleClass="dashboard-header">
        <padding><Insets left="30" right="30" top="15" bottom="15" /></padding>
        <spacing>30</spacing>
        <alignment>CENTER_LEFT</alignment>
        <children>
            <Label text="Dashboard" styleClass="dashboard-title" HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" text="Welcome, Admin" styleClass="dashboard-welcome" />
            <Button text="Logout" onAction="#onLogout" styleClass="logout-btn" />
        </children>
    </HBox>

    <!-- Main Content -->
    <VBox layoutX="168.0" layoutY="60.0" prefHeight="740.0" prefWidth="1112.0" spacing="20">
        <padding><Insets left="20" right="20" top="20" bottom="20" /></padding>

        <!-- Stats Cards Row -->
        <HBox spacing="20" prefHeight="120.0">
            <!-- Today's Sales -->
            <AnchorPane prefWidth="260.0" prefHeight="120.0" styleClass="stat-card-green">
                <Label layoutX="20" layoutY="15" text="Today's Sales" styleClass="stat-label" />
                <Label fx:id="todaysSalesLabel" layoutX="20" layoutY="50" text="₹0.00" styleClass="stat-value" />
            </AnchorPane>

            <!-- Total Products -->
            <AnchorPane prefWidth="260.0" prefHeight="120.0" styleClass="stat-card-blue">
                <Label layoutX="20" layoutY="15" text="Total Products" styleClass="stat-label" />
                <Label fx:id="totalProductsLabel" layoutX="20" layoutY="50" text="0" styleClass="stat-value" />
            </AnchorPane>

            <!-- Low Stock Alert -->
            <AnchorPane prefWidth="260.0" prefHeight="120.0" styleClass="stat-card-red">
                <Label layoutX="20" layoutY="15" text="Low Stock Alert" styleClass="stat-label" />
                <Label fx:id="lowStockLabel" layoutX="20" layoutY="50" text="0 Items" styleClass="stat-value" />
            </AnchorPane>

            <!-- Total Customers -->
            <AnchorPane prefWidth="260.0" prefHeight="120.0" styleClass="stat-card-orange">
                <Label layoutX="20" layoutY="15" text="Total Customers" styleClass="stat-label" />
                <Label fx:id="totalCustomersLabel" layoutX="20" layoutY="50" text="0" styleClass="stat-value" />
            </AnchorPane>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="15" prefHeight="50.0">
            <Button text="➕ Add Product" prefWidth="150" onAction="#openElectronics" styleClass="action-btn-blue" />
            <Button text="🛒 New Sale" prefWidth="150" onAction="#openCart" styleClass="action-btn-green" />
            <Button text="👤 Add Customer" prefWidth="150" onAction="#openFashion" styleClass="action-btn-orange" />
            <Button text="📦 Restock Items" prefWidth="150" onAction="#openStock" styleClass="action-btn-purple" />
        </HBox>

        <!-- Content Area: Sales Overview and Recent Activity -->
        <HBox spacing="20" prefHeight="350.0" VBox.vgrow="ALWAYS">
            <!-- Sales Overview (Left) -->
            <AnchorPane prefWidth="700.0" styleClass="content-card">
                <Label layoutX="20" layoutY="15" text="Sales Overview" styleClass="section-title" />
                <Label layoutX="20" layoutY="45" prefWidth="660" prefHeight="280" text="[Chart Area - Sales by Day]"
                       styleClass="chart-placeholder" wrapText="true" />
            </AnchorPane>

            <!-- Recent Activity (Right) -->
            <VBox spacing="20" prefWidth="370.0">
                <!-- Latest Sales -->
                <AnchorPane prefHeight="170.0" styleClass="content-card">
                    <Label layoutX="15" layoutY="12" text="Latest Sales" styleClass="section-title" />
                    <VBox layoutX="15" layoutY="45" spacing="12" prefWidth="340.0">
                        <Label text="🔵 Sale #1021" styleClass="activity-item" />
                        <Label text="₹ 3,200" styleClass="activity-amount" />
                        <Separator />
                        <Label text="🔵 Sale #1020" styleClass="activity-item" />
                        <Label text="₹ 5,500" styleClass="activity-amount" />
                        <Separator />
                        <Label text="🔵 Sale #1019" styleClass="activity-item" />
                        <Label text="₹ 1,800" styleClass="activity-amount" />
                    </VBox>
                </AnchorPane>

                <!-- Recent Products -->
                <AnchorPane prefHeight="140.0" styleClass="content-card">
                    <Label layoutX="15" layoutY="12" text="Recent Products" styleClass="section-title" />
                    <VBox layoutX="15" layoutY="45" spacing="10" prefWidth="340.0">
                        <Label text="🟢 Wireless Mouse" styleClass="activity-item" />
                        <Label text="🟢 Apple Juice" styleClass="activity-item" />
                        <Label text="🟢 LED TV" styleClass="activity-item" />
                    </VBox>
                </AnchorPane>

                <!-- New Customers -->
                <AnchorPane prefHeight="140.0" styleClass="content-card">
                    <Label layoutX="15" layoutY="12" text="New Customers" styleClass="section-title" />
                    <VBox layoutX="15" layoutY="45" spacing="10" prefWidth="340.0">
                        <Label text="👤 Rahim Khan" styleClass="activity-item" />
                        <Label text="👤 Mina Akter" styleClass="activity-item" />
                        <Label text="👤 S. Alam" styleClass="activity-item" />
                    </VBox>
                </AnchorPane>
            </VBox>
        </HBox>

        <Label fx:id="statusLabel" text="" styleClass="home-status" />
    </VBox>

</AnchorPane>
