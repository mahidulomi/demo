<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1250.0" stylesheets="@style.css" styleClass="home-page-bg"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.HomeController">

    <!-- Sidebar Navigation -->
    <VBox prefWidth="168.0" styleClass="dashboard-sidebar" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <padding><Insets top="20" left="10" right="10" bottom="20" /></padding>
        <spacing>15</spacing>
        <children>
            <!-- Navigation Items -->
            <Button text="🏠 Home" prefWidth="150" onAction="#onNavHome" styleClass="sidebar-btn-active" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button fx:id="productsBtn" text="📦 Products" prefWidth="150" onAction="#onProductsClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="💰 Sales" prefWidth="150" onAction="#onSalesClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="📥 Restock" prefWidth="150" onAction="#onRestockClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="👥 Customers" prefWidth="150" onAction="#onCustomersClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="📊 Reports" prefWidth="150" onAction="#onReportsClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
            <Button text="➕ Add Product" prefWidth="150" onAction="#onOpenAddProductModal" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />

            <Separator />

            <Button text="ℹ️ About" prefWidth="150" onAction="#onProfileClick" styleClass="sidebar-btn" style="-fx-font-size: 12; -fx-padding: 10; -fx-letter-spacing: 1;" />
        </children>
    </VBox>

    <!-- Header -->
    <HBox prefHeight="60.0" styleClass="dashboard-header" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets left="30" right="30" top="15" bottom="15" /></padding>
        <spacing>30</spacing>
        <alignment>CENTER_LEFT</alignment>
        <children>
            <Label text="Dashboard" styleClass="dashboard-title" HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" text="Welcome, Admin" styleClass="dashboard-welcome" />
            <Button text="LOGOUT" onAction="#onLogout" prefWidth="100" prefHeight="35" textAlignment="CENTER" contentDisplay="CENTER" textFill="WHITE" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 900; -fx-padding: 0; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-width: 0; -fx-border-radius: 6; -fx-effect: dropshadow(gaussian, rgba(220, 38, 38, 0.4), 8, 0, 0, 2);">
                <font><Font name="System Bold" size="12"/></font>
            </Button>
        </children>
    </HBox>

    <!-- Main Content -->
    <VBox spacing="20" styleClass="dashboard-main" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="168.0" AnchorPane.rightAnchor="0.0">
        <padding><Insets left="20" right="20" top="20" bottom="20" /></padding>

        <!-- Stats Cards Row -->
        <HBox spacing="20" prefHeight="120.0" styleClass="dashboard-stats-row">
            <!-- Today's Sales -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-green">
                <Label layoutX="20" layoutY="15" text="Today's Sales" styleClass="stat-label" />
                <Label fx:id="todaysSalesLabel" layoutX="20" layoutY="50" text="₹0.00" styleClass="stat-value" />
            </AnchorPane>

            <!-- Total Products -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-blue">
                <Label layoutX="20" layoutY="15" text="Total Products" styleClass="stat-label" />
                <Label fx:id="totalProductsLabel" layoutX="20" layoutY="50" text="0" styleClass="stat-value" />
            </AnchorPane>

            <!-- Low Stock Alert -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-red">
                <Label layoutX="20" layoutY="15" text="Low Stock Alert" styleClass="stat-label" />
                <Label fx:id="lowStockLabel" layoutX="20" layoutY="50" text="0 Items" styleClass="stat-value" />
            </AnchorPane>

            <!-- Total Sales -->
            <AnchorPane HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="120.0" styleClass="stat-card-orange">
                <Label layoutX="20" layoutY="15" text="Total Sales" styleClass="stat-label" />
                <Label fx:id="totalSalesLabel" layoutX="20" layoutY="50" text="₹0.00" styleClass="stat-value" />
            </AnchorPane>
        </HBox>

        <!-- Content Area: Full Width Sales Overview -->
        <AnchorPane prefHeight="350.0" VBox.vgrow="ALWAYS" styleClass="content-card">
            <Label layoutX="20" layoutY="15" text="Sales Overview" styleClass="section-title" />
            <AreaChart fx:id="salesChart" layoutX="10.0" layoutY="45.0" prefHeight="280.0" prefWidth="660.0" legendVisible="false" verticalGridLinesVisible="false" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="45.0">
                <xAxis>
                    <CategoryAxis fx:id="xAxis" side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxis" side="LEFT" />
                </yAxis>
            </AreaChart>
        </AnchorPane>


        <Label fx:id="statusLabel" text="" styleClass="home-status" />
    </VBox>

    <!-- Add Product Overlay -->
    <AnchorPane fx:id="addProductOverlay" visible="false" styleClass="product-modal-overlay" onMouseClicked="#onProductOverlayBackgroundClick"
                AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
        <AnchorPane prefWidth="900.0" prefHeight="380.0" styleClass="product-modal-panel" onMouseClicked="#onProductPanelClick"
                    AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="160.0">

            <Button text="✕" onAction="#onCloseAddProductModal" styleClass="product-close-btn"
                    AnchorPane.topAnchor="4.0" AnchorPane.rightAnchor="10.0" />

            <HBox spacing="60" AnchorPane.topAnchor="44.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0">
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Product ID:" styleClass="product-form-label" prefWidth="105.0" />
                        <TextField fx:id="productIdField" promptText="PROD_040" styleClass="product-form-field" prefWidth="180.0" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Product Name:" styleClass="product-form-label" prefWidth="130.0" />
                        <TextField fx:id="productNameField" promptText="Enter product name" styleClass="product-form-field" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Type:" styleClass="product-form-label" prefWidth="105.0" />
                        <ComboBox fx:id="productCategoryCombo" promptText="Choose type" styleClass="product-form-field" prefWidth="180.0" />
                    </HBox>
                </VBox>

                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Stock:" styleClass="product-form-label" prefWidth="90.0" />
                        <TextField fx:id="productStockField" promptText="0" styleClass="product-form-field" prefWidth="220.0" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Price (Tk):" styleClass="product-form-label" prefWidth="90.0" />
                        <TextField fx:id="productPriceField" promptText="0.00" styleClass="product-form-field" prefWidth="220.0" />
                    </HBox>
                </VBox>

                <VBox spacing="35" alignment="CENTER">
                    <ImageView fx:id="productPreviewImage" fitWidth="120.0" fitHeight="120.0" preserveRatio="true" styleClass="product-image-preview" />
                    <Button text="Import" onAction="#onImportProductImage" styleClass="product-action-btn product-action-import" prefWidth="120.0" />
                    <Label fx:id="selectedImageLabel" text="No image selected" styleClass="product-image-label" />
                </VBox>
            </HBox>

            <HBox spacing="16" AnchorPane.leftAnchor="24.0" AnchorPane.bottomAnchor="18.0">
                <Button text="Add" onAction="#onAddProduct" styleClass="product-action-btn product-action-add" prefWidth="110.0" />
                <Button text="Clear" onAction="#onClearProductForm" styleClass="product-action-btn product-action-clear" prefWidth="110.0" />
            </HBox>
        </AnchorPane>
    </AnchorPane>

</AnchorPane>
